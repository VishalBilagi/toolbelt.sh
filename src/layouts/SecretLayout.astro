---
import '../styles/theme.css';
import Icon from '../components/ui/Icon.astro';
import { localizeAppLink, resolveLocaleFromPathname } from '../i18n';
import { secretMessages } from '../tools/secret-link/messages';

interface Props { title: string }
const { title } = Astro.props;
const locale = resolveLocaleFromPathname(Astro.url.pathname);
const copy = secretMessages[locale];
// Deliberately independent of AppShell: no telemetry, flags, fonts, storage, or shell scripts.
const policy = "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'";
---
<!doctype html>
<html lang={locale} data-mode="light">
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={policy} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={copy.intro} />
    <title>{title} · toolbelt.sh</title>
  </head>
  <body>
    <a class="secret-skip" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="secret-header">
      <a class="secret-brand" href={localizeAppLink('/', locale)}><Icon name="lock" size={22} /> toolbelt<span>.sh</span></a>
      <a href={localizeAppLink('/tools', locale)}>{copy.back} <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
<style>
  .secret-header { max-width: 72rem; margin: auto; padding: var(--space-xl) var(--space-xl); display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); border-bottom: 1px solid var(--border-default); }
  .secret-brand { display: inline-flex; gap: var(--space-sm); align-items: center; color: var(--text-primary); font-size: 1.15rem; font-weight: 750; }
  .secret-brand span { color: var(--accent); margin-left: -.4rem; }
  .secret-skip { position: absolute; top: -5rem; left: 1rem; background: var(--bg-surface); padding: 1rem; z-index: 10; }
  .secret-skip:focus { top: 1rem; }
</style>
