---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/globals.css';
import Icon from '../components/ui/Icon.astro';
import ToolSearch from '../components/ToolSearch.astro';
import { toolSections } from '../data/tool-directory';
import {
  createTranslator,
  getAlternateLocaleLinks,
  getLocaleSwitcherPath,
  getLocalizedToolSectionTitle,
  getLocalizedToolText,
  hasLocalePrefix,
  localizeAppLink,
  resolveLocaleFromPathname,
  stripLocalePrefix,
} from '../i18n';
import {
  DEFAULT_LOCALE,
  PREFERRED_LOCALE_COOKIE,
  PREFERRED_LOCALE_STORAGE_KEY,
  SUPPORTED_LOCALES,
} from '../i18n/config';
interface Props {
  title: string;
  description?: string;
}
const locale = resolveLocaleFromPathname(Astro.url.pathname);
const translate = createTranslator(locale);
const {
  title,
  description = translate('shell.meta.defaultDescription'),
} = Astro.props;
const pathname = Astro.url.pathname;
const basePathname = stripLocalePrefix(pathname);
const pageUrl = Astro.url.href;
const siteName = 'toolbelt.sh';
const socialImageUrl = '/og-preview.svg';
const alternateLocaleLinks = getAlternateLocaleLinks(Astro.url);
const hasExplicitLocalePrefix = hasLocalePrefix(pathname);
const shouldAutoRedirectToPreferredLocale = !hasExplicitLocalePrefix && (basePathname === '/' || basePathname === '/tools');
const githubUrl = 'https://github.com/VishalBilagi/toolbelt.sh';
const ldClientId = `${import.meta.env.LD_CLIENT_ID ?? ''}`.trim();
const appVersion = `${import.meta.env.PUBLIC_APP_VERSION ?? import.meta.env.npm_package_version ?? 'dev'}`.trim();
const localeOptions = SUPPORTED_LOCALES.map((optionLocale) => ({
  code: optionLocale,
  label: translate(
    optionLocale === 'en' ? 'shell.localeSwitcher.option.en' : 'shell.localeSwitcher.option.es'
  ),
  href: getLocaleSwitcherPath(pathname, optionLocale),
}));

const activeTool = toolSections.flatMap(section => section.tools).find(tool => tool.href === basePathname);
const pageLabel = activeTool ? getLocalizedToolText(locale, activeTool.href, activeTool.name, activeTool.description).name : translate('shell.nav.allTools');
---
<!doctype html>
<html lang={locale} data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="toolbelt.sh preview showing the tagline Powerful Developer Tools. Zero Server Uploads." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="toolbelt.sh preview showing the tagline Powerful Developer Tools. Zero Server Uploads." />
    {
      alternateLocaleLinks.map((link) => (
        <link rel="alternate" hreflang={link.locale} href={link.href} />
      ))
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      (() => {
        try {
          const savedMode = localStorage.getItem('mode');
          document.documentElement.dataset.mode = savedMode === 'dark' ? 'dark' : 'light';
        } catch { document.documentElement.dataset.mode = 'light'; }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{translate('workbench.skip')}</a>
    <div class="app-frame">
      <aside class="sidebar" id="site-sidebar" aria-label={translate('shell.nav.primaryAria')}>
        <a href={localizeAppLink('/', locale)} class="brand"><span class="brand-symbol"><Icon name="terminal" /></span><span>toolbelt<span class="brand-domain">.sh</span></span></a>
        <p class="sidebar-caption">{translate('workbench.tagline')}</p>
        <button class="sidebar-search" type="button" data-search-open><Icon name="search" /><span>{translate('workbench.search')}</span><kbd>⌘ K</kbd></button>
        <nav class="sidebar-nav">
          <a class:list={['nav-overview', { 'is-active': !activeTool }]} href={localizeAppLink('/tools', locale)} aria-current={!activeTool ? 'page' : undefined}><Icon name="grid" /><span>{translate('shell.nav.allTools')}</span><span class="nav-count">{toolSections.flatMap(section => section.tools).length}</span></a>
          {toolSections.map(section => (
            <div class="nav-section">
              <p class="nav-section-title">{getLocalizedToolSectionTitle(locale, section.id, section.title)}</p>
              {section.tools.map(tool => (
                <a class:list={['sidebar-link', { 'is-active': tool.href === basePathname }]} href={localizeAppLink(tool.href, locale)} aria-current={tool.href === basePathname ? 'page' : undefined}>
                  <Icon name={tool.icon} /><span>{getLocalizedToolText(locale, tool.href, tool.name, tool.description).name}</span>
                </a>
              ))}
            </div>
          ))}
        </nav>
        <div class="sidebar-bottom">
          <div class="local-note"><Icon name="lock" /><div><strong>{translate('workbench.localTitle')}</strong><p>{translate('workbench.localBody')}</p></div></div>
          <a class="source-link" href={githubUrl} target="_blank" rel="noreferrer"><Icon name="github" /><span>{translate('workbench.openSource')}</span><Icon name="arrow-up-right" /></a>
        </div>
      </aside>
      <button class="sidebar-backdrop" type="button" data-sidebar-close aria-label={translate('workbench.closeNav')} hidden></button>
      <div class="app-main">
        <header class="topbar" aria-label={translate('shell.header.aria')}>
          <div class="topbar-location"><button class="icon-button mobile-menu" type="button" data-sidebar-toggle aria-controls="site-sidebar" aria-expanded="false" aria-label={translate('workbench.openNav')}><Icon name="menu" /></button><a href={localizeAppLink('/tools', locale)}>{translate('workbench.workspace')}</a><span class="breadcrumb-divider">/</span><span class="topbar-page">{pageLabel}</span></div>
          <div class="header-actions">
            <span class="browser-badge"><span class="status-dot"></span>{translate('workbench.browserBadge')}</span>
            <button class="icon-button topbar-search" type="button" data-search-open aria-label={translate('workbench.search')}><Icon name="search" /></button>
            <label class="visually-hidden" for="header-locale-switcher">{translate('shell.localeSwitcher.label')}</label>
            <select id="header-locale-switcher" class="locale-switcher" data-locale-switcher>
              {localeOptions.map(option => <option value={option.code} data-path={option.href} selected={option.code === locale}>{option.code.toUpperCase()}</option>)}
            </select>
            <button class="icon-button theme-toggle" type="button" data-mode-toggle aria-label={translate('workbench.theme')} title={translate('workbench.theme')}><span class="icon-moon"><Icon name="moon" /></span><span class="icon-sun"><Icon name="sun" /></span></button>
          </div>
        </header>
        <slot />
        <footer class="app-footer"><span>toolbelt.sh <span class="footer-separator">/</span> {translate('workbench.footer')}</span><span>{translate('shell.footer.version')} {appVersion}</span></footer>
      </div>
    </div>
    <ToolSearch />
    <script
      is:inline
      define:vars={{
        defaultLocale: DEFAULT_LOCALE,
        localeStorageKey: PREFERRED_LOCALE_STORAGE_KEY,
        localeCookieName: PREFERRED_LOCALE_COOKIE,
        shouldAutoRedirectToPreferredLocale,
      }}
    >
      (() => {
        const initLocaleSwitchers = () => {
          const switchers = Array.from(document.querySelectorAll('[data-locale-switcher]'));
          if (!switchers.length) return;

          const parseCookieLocale = () => {
            const cookie = document.cookie
              .split('; ')
              .find((entry) => entry.startsWith(`${localeCookieName}=`));
            if (!cookie) return '';
            const [, value = ''] = cookie.split('=');
            return decodeURIComponent(value);
          };

          const getSavedLocale = () => {
            try {
              const stored = localStorage.getItem(localeStorageKey);
              if (typeof stored === 'string' && stored.length > 0) return stored;
            } catch {
            }

            return parseCookieLocale();
          };

          const persistLocale = (nextLocale) => {
            try {
              localStorage.setItem(localeStorageKey, nextLocale);
            } catch {
            }

            document.cookie = `${localeCookieName}=${encodeURIComponent(nextLocale)}; path=/; max-age=31536000; samesite=lax`;
          };

          const primarySwitcher = switchers.find((node) => node instanceof HTMLSelectElement);
          if (shouldAutoRedirectToPreferredLocale && primarySwitcher instanceof HTMLSelectElement) {
            const savedLocale = getSavedLocale();
            if (savedLocale && savedLocale !== defaultLocale) {
              const targetOption = Array.from(primarySwitcher.options).find((option) => option.value === savedLocale);
              const targetPath = targetOption?.dataset.path;
              if (typeof targetPath === 'string' && targetPath.length > 0) {
                window.location.replace(targetPath);
                return;
              }
            }
          }

          for (const switcher of switchers) {
            if (!(switcher instanceof HTMLSelectElement)) continue;
            if (switcher.dataset.localeBound === 'true') continue;

            switcher.dataset.localeBound = 'true';
            switcher.addEventListener('change', () => {
              const selectedOption = switcher.selectedOptions.item(0);
              const nextLocale = switcher.value;
              const nextPath = selectedOption?.dataset.path;

              if (!nextLocale) return;

              persistLocale(nextLocale);

              if (typeof nextPath === 'string' && nextPath.length > 0) {
                window.location.assign(nextPath);
              }
            });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initLocaleSwitchers, { once: true });
        } else {
          initLocaleSwitchers();
        }
      })();
    </script>
    <script is:inline define:vars={{ ldClientId }}>
      window.__toolbeltConfig = {
        ...(window.__toolbeltConfig || {}),
        ldClientId
      };
    </script>
    <script>
      import { configureFeatureFlags, primeFeatureFlags } from '../lib/feature-flags';

      const runtimeLdClientId =
        (window.__toolbeltConfig && typeof window.__toolbeltConfig.ldClientId === 'string'
          ? window.__toolbeltConfig.ldClientId
          : '') || '';

      configureFeatureFlags({ ldClientId: runtimeLdClientId });
      void primeFeatureFlags();

    </script>
    <script>
      import { initShell } from '../lib/workbench';
      initShell();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
