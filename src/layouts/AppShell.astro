---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import globalStyles from '../styles/globals.css?inline';
import { toolSections, type ToolIcon } from '../data/tool-directory';
import {
  createTranslator,
  getAlternateLocaleLinks,
  getLocaleSwitcherPath,
  getLocalizedToolSectionTitle,
  getLocalizedToolText,
  hasLocalePrefix,
  localizeAppLink,
  resolveLocaleFromPathname,
  stripLocalePrefix,
} from '../i18n';
import {
  DEFAULT_LOCALE,
  PREFERRED_LOCALE_COOKIE,
  PREFERRED_LOCALE_STORAGE_KEY,
  SUPPORTED_LOCALES,
} from '../i18n/config';
interface Props {
  title: string;
  description?: string;
}
const locale = resolveLocaleFromPathname(Astro.url.pathname);
const translate = createTranslator(locale);
const {
  title,
  description = translate('shell.meta.defaultDescription'),
} = Astro.props;
const pathname = Astro.url.pathname;
const basePathname = stripLocalePrefix(pathname);
const pageUrl = Astro.url.href;
const siteName = 'toolbelt.sh';
const socialImageUrl = '/og-preview.svg';
const alternateLocaleLinks = getAlternateLocaleLinks(Astro.url);
const isHomeRoute = basePathname === '/';
const hasExplicitLocalePrefix = hasLocalePrefix(pathname);
const shouldAutoRedirectToPreferredLocale = !hasExplicitLocalePrefix && (basePathname === '/' || basePathname === '/tools');
const disableScrollReveal =
  basePathname.startsWith('/tools/') && basePathname !== '/tools' && basePathname !== '/tools/';
const githubUrl = 'https://github.com/VishalBilagi/toolbelt.sh';
const ldClientId = `${import.meta.env.LD_CLIENT_ID ?? ''}`.trim();
const appVersion = `${import.meta.env.PUBLIC_APP_VERSION ?? import.meta.env.npm_package_version ?? 'dev'}`.trim();
const localeOptions = SUPPORTED_LOCALES.map((optionLocale) => ({
  code: optionLocale,
  label: translate(
    optionLocale === 'en' ? 'shell.localeSwitcher.option.en' : 'shell.localeSwitcher.option.es'
  ),
  href: getLocaleSwitcherPath(pathname, optionLocale),
}));

const coreNavItems = [
  { href: '/', label: translate('shell.nav.home'), matches: ['/', '/index.html'] },
  { href: '/tools', label: translate('shell.nav.allTools'), matches: ['/tools'] }
];

const isNavActive = (href: string, matches: string[]): boolean =>
  href === '/tools'
    ? matches.some((match) => basePathname === match || basePathname === `${match}/`)
    : matches.some((match) => basePathname === match || basePathname.startsWith(`${match}/`));

const isToolActive = (href: string): boolean => basePathname === href || basePathname.startsWith(`${href}/`);

const isSectionActive = (section: (typeof toolSections)[number]): boolean =>
  section.tools.some((tool) => isToolActive(tool.href));

const boxIconByToolIcon: Record<ToolIcon, string> = {
  qr: 'qr-scan',
  crop: 'crop',
  svg: 'image-sparkle',
  data: 'database',
  lock: 'lock',
  clock: 'clock',
  'image-no-background': 'image-no-background',
  eyedropper: 'eyedropper',
  'plus-minus': 'plus-minus',
  'table-layout': 'table-layout'
};
---
<!doctype html>
<html lang={locale} data-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="toolbelt.sh preview showing the tagline Powerful Developer Tools. Zero Server Uploads." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="toolbelt.sh preview showing the tagline Powerful Developer Tools. Zero Server Uploads." />
    {
      alternateLocaleLinks.map((link) => (
        <link rel="alternate" hreflang={link.locale} href={link.href} />
      ))
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <style is:inline set:html={globalStyles}></style>
    <script is:inline>
      (() => {
        const savedMode = localStorage.getItem('mode');
        const mode = savedMode === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-mode', mode);
      })();
    </script>
  </head>
  <body>
    <script is:inline define:vars={{ disableScrollReveal }}>
      const html = document.documentElement;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const updateModeToggleState = () => {
        const mode = html.getAttribute('data-mode') === 'light' ? 'light' : 'dark';
        const nextMode = mode === 'dark' ? 'light' : 'dark';

        document.querySelectorAll('[data-mode-toggle]').forEach((node) => {
          node.setAttribute('aria-label', `Switch to ${nextMode} mode`);
          node.setAttribute('title', `Switch to ${nextMode} mode`);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateModeToggleState);
      } else {
        updateModeToggleState();
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const toggle = target.closest('[data-mode-toggle]');
        if (!toggle) return;

        const currentMode = html.getAttribute('data-mode') === 'light' ? 'light' : 'dark';
        const nextMode = currentMode === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-mode', nextMode);
        localStorage.setItem('mode', nextMode);
        updateModeToggleState();
      });

      const setupScrollReveal = () => {
        if (disableScrollReveal) return;
        if (prefersReducedMotion || !('IntersectionObserver' in window)) return;

        const selector = '.ui-card, .tool-card, .trust-item, .tool-category, .ui-panel, .ui-empty-state';
        const elements = Array.from(document.querySelectorAll(selector)).filter(
          (node) => !node.closest('.site-header')
        );
        if (!elements.length) return;

        let index = 0;
        for (const element of elements) {
          if (!(element instanceof HTMLElement)) continue;
          if (element.classList.contains('reveal-on-scroll')) continue;

          element.classList.add('reveal-on-scroll');
          element.style.setProperty('--reveal-delay', `${Math.min(index * 18, 120)}ms`);
          index += 1;
        }

        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              currentObserver.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
        );

        for (const element of elements) {
          observer.observe(element);
        }
      };

      const setupPageTransitions = () => {
        if (prefersReducedMotion) return;

        window.addEventListener('pageshow', () => {
          document.body.classList.remove('is-page-leaving');
        });

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const target = event.target;
          if (!(target instanceof Element)) return;

          const link = target.closest('a[href]');
          if (!(link instanceof HTMLAnchorElement)) return;
          if (link.target && link.target !== '_self') return;
          if (link.hasAttribute('download')) return;
          if (link.dataset.noPageTransition === 'true') return;

          const url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;

          const isSameRoute = url.pathname === window.location.pathname && url.search === window.location.search;
          if (isSameRoute) return;

          event.preventDefault();
          document.body.classList.add('is-page-leaving');

          window.setTimeout(() => {
            window.location.assign(url.toString());
          }, 100);
        });
      };

      const setupSamePageAnchorScroll = () => {
        const normalizePath = (value) => {
          const withoutIndex = value.replace(/\/index\.html$/, '/');
          const collapsed = withoutIndex.replace(/\/{2,}/g, '/');
          if (collapsed === '') return '/';
          return collapsed.endsWith('/') ? collapsed : `${collapsed}/`;
        };

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const target = event.target;
          if (!(target instanceof Element)) return;

          const link = target.closest('a[href]');
          if (!(link instanceof HTMLAnchorElement)) return;
          if (link.target && link.target !== '_self') return;
          if (link.hasAttribute('download')) return;

          const href = link.getAttribute('href');
          if (!href || !href.includes('#')) return;

          const url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (!url.hash || url.hash === '#') return;

          const samePath = normalizePath(url.pathname) === normalizePath(window.location.pathname);
          if (!samePath || url.search !== window.location.search) return;

          const targetId = decodeURIComponent(url.hash.slice(1));
          const targetElement = document.getElementById(targetId);
          if (!(targetElement instanceof HTMLElement)) return;

          event.preventDefault();

          const header = document.querySelector('.site-header');
          const headerOffset = header instanceof HTMLElement ? header.getBoundingClientRect().height + 12 : 12;
          const top = Math.max(0, window.scrollY + targetElement.getBoundingClientRect().top - headerOffset);

          if (window.location.hash !== url.hash) {
            history.pushState(null, '', url.hash);
          }

          window.scrollTo({
            top,
            behavior: prefersReducedMotion ? 'auto' : 'smooth'
          });
        });
      };

      const setupGroupedNavHoverMenus = () => {
        const groups = Array.from(document.querySelectorAll('.nav-group')).filter(
          (node) => node instanceof HTMLElement
        );
        if (!groups.length) return;

        const mobileNavMedia = window.matchMedia('(max-width: 640px)');

        const setMobileOpen = (group, isOpen) => {
          group.classList.toggle('is-mobile-open', isOpen);

          const trigger = group.querySelector('.nav-group-trigger');
          if (trigger instanceof HTMLButtonElement) {
            trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          }
        };

        const closeAllMobileMenus = (exception = null) => {
          for (const group of groups) {
            if (group === exception) continue;
            setMobileOpen(group, false);
          }
        };

        const syncGroupedNavState = () => {
          if (!mobileNavMedia.matches) {
            for (const group of groups) {
              group.classList.remove('is-hover-open');
              setMobileOpen(group, false);
            }
            return;
          }

          const activeGroup = groups.find((group) => group.classList.contains('nav-group--active'));
          if (activeGroup && !groups.some((group) => group.classList.contains('is-mobile-open'))) {
            setMobileOpen(activeGroup, true);
          } else {
            for (const group of groups) {
              const isOpen = group.classList.contains('is-mobile-open');
              setMobileOpen(group, isOpen);
            }
          }
        };

        for (const group of groups) {
          const menu = group.querySelector('.nav-menu');
          const trigger = group.querySelector('.nav-group-trigger');
          let closeTimer = 0;

          const open = () => {
            if (mobileNavMedia.matches) return;
            window.clearTimeout(closeTimer);
            group.classList.add('is-hover-open');
          };

          const closeSoon = () => {
            if (mobileNavMedia.matches) return;
            window.clearTimeout(closeTimer);
            closeTimer = window.setTimeout(() => {
              group.classList.remove('is-hover-open');
            }, 90);
          };

          group.addEventListener('mouseenter', open);
          group.addEventListener('mouseleave', closeSoon);

          if (menu instanceof HTMLElement) {
            menu.addEventListener('mouseenter', open);
            menu.addEventListener('mouseleave', closeSoon);
          }

          if (trigger instanceof HTMLButtonElement) {
            trigger.addEventListener('click', () => {
              if (!mobileNavMedia.matches) return;

              const willOpen = !group.classList.contains('is-mobile-open');
              closeAllMobileMenus(willOpen ? group : null);
              setMobileOpen(group, willOpen);
            });
          }
        }

        if (typeof mobileNavMedia.addEventListener === 'function') {
          mobileNavMedia.addEventListener('change', syncGroupedNavState);
        } else if (typeof mobileNavMedia.addListener === 'function') {
          mobileNavMedia.addListener(syncGroupedNavState);
        }

        syncGroupedNavState();
      };

      const setupMobileNavDrawer = () => {
        const nav = document.querySelector('[data-mobile-nav]');
        const toggles = Array.from(document.querySelectorAll('[data-mobile-nav-toggle]'));
        const backdrop = document.querySelector('[data-mobile-nav-backdrop]');
        if (!(nav instanceof HTMLElement) || !(backdrop instanceof HTMLElement) || !toggles.length) return;

        const mobileNavMedia = window.matchMedia('(max-width: 640px)');
        let isOpen = false;

        const setMobileNavOpen = (nextOpen) => {
          const shouldOpen = mobileNavMedia.matches && nextOpen;
          isOpen = shouldOpen;

          document.body.classList.toggle('mobile-nav-open', shouldOpen);

          for (const toggle of toggles) {
            if (!(toggle instanceof HTMLButtonElement)) continue;
            toggle.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
            toggle.setAttribute('aria-label', shouldOpen ? 'Close navigation menu' : 'Open navigation menu');
            toggle.setAttribute('title', shouldOpen ? 'Close navigation menu' : 'Open navigation menu');
          }
        };

        const closeMobileNav = () => setMobileNavOpen(false);

        for (const toggle of toggles) {
          if (!(toggle instanceof HTMLButtonElement)) continue;

          toggle.addEventListener('click', () => {
            setMobileNavOpen(!isOpen);
          });
        }

        backdrop.addEventListener('click', closeMobileNav);

        nav.addEventListener('click', (event) => {
          if (!mobileNavMedia.matches) return;

          const target = event.target;
          if (!(target instanceof Element)) return;

          const clickedLink = target.closest('a[href]');
          if (clickedLink instanceof HTMLAnchorElement) {
            closeMobileNav();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !isOpen) return;
          closeMobileNav();
        });

        const syncMobileNavForViewport = () => {
          if (!mobileNavMedia.matches) {
            closeMobileNav();
          } else {
            setMobileNavOpen(isOpen);
          }
        };

        if (typeof mobileNavMedia.addEventListener === 'function') {
          mobileNavMedia.addEventListener('change', syncMobileNavForViewport);
        } else if (typeof mobileNavMedia.addListener === 'function') {
          mobileNavMedia.addListener(syncMobileNavForViewport);
        }

        setMobileNavOpen(false);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupScrollReveal();
          setupSamePageAnchorScroll();
          setupPageTransitions();
          setupGroupedNavHoverMenus();
          setupMobileNavDrawer();
        });
      } else {
        setupScrollReveal();
        setupSamePageAnchorScroll();
        setupPageTransitions();
        setupGroupedNavHoverMenus();
        setupMobileNavDrawer();
      }
    </script>
    <script
      is:inline
      define:vars={{
        defaultLocale: DEFAULT_LOCALE,
        localeStorageKey: PREFERRED_LOCALE_STORAGE_KEY,
        localeCookieName: PREFERRED_LOCALE_COOKIE,
        shouldAutoRedirectToPreferredLocale,
      }}
    >
      (() => {
        const initLocaleSwitchers = () => {
          const switchers = Array.from(document.querySelectorAll('[data-locale-switcher]'));
          if (!switchers.length) return;

          const parseCookieLocale = () => {
            const cookie = document.cookie
              .split('; ')
              .find((entry) => entry.startsWith(`${localeCookieName}=`));
            if (!cookie) return '';
            const [, value = ''] = cookie.split('=');
            return decodeURIComponent(value);
          };

          const getSavedLocale = () => {
            try {
              const stored = localStorage.getItem(localeStorageKey);
              if (typeof stored === 'string' && stored.length > 0) return stored;
            } catch {
            }

            return parseCookieLocale();
          };

          const persistLocale = (nextLocale) => {
            try {
              localStorage.setItem(localeStorageKey, nextLocale);
            } catch {
            }

            document.cookie = `${localeCookieName}=${encodeURIComponent(nextLocale)}; path=/; max-age=31536000; samesite=lax`;
          };

          const primarySwitcher = switchers.find((node) => node instanceof HTMLSelectElement);
          if (shouldAutoRedirectToPreferredLocale && primarySwitcher instanceof HTMLSelectElement) {
            const savedLocale = getSavedLocale();
            if (savedLocale && savedLocale !== defaultLocale) {
              const targetOption = Array.from(primarySwitcher.options).find((option) => option.value === savedLocale);
              const targetPath = targetOption?.dataset.path;
              if (typeof targetPath === 'string' && targetPath.length > 0) {
                window.location.replace(targetPath);
                return;
              }
            }
          }

          for (const switcher of switchers) {
            if (!(switcher instanceof HTMLSelectElement)) continue;
            if (switcher.dataset.localeBound === 'true') continue;

            switcher.dataset.localeBound = 'true';
            switcher.addEventListener('change', () => {
              const selectedOption = switcher.selectedOptions.item(0);
              const nextLocale = switcher.value;
              const nextPath = selectedOption?.dataset.path;

              if (!nextLocale) return;

              persistLocale(nextLocale);

              if (typeof nextPath === 'string' && nextPath.length > 0) {
                window.location.assign(nextPath);
              }
            });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initLocaleSwitchers, { once: true });
        } else {
          initLocaleSwitchers();
        }
      })();
    </script>
    <script is:inline define:vars={{ ldClientId }}>
      window.__toolbeltConfig = {
        ...(window.__toolbeltConfig || {}),
        ldClientId
      };
    </script>
    <script>
      import {
        getIcons,
        Moon,
        Sun,
        Github,
        Lock,
        Bolt,
        MobileAlt,
        QrScan,
        Crop,
        Database,
        Grid,
        ImageSparkle,
        Clock,
        ImageNoBackground,
        Eyedropper,
        PlusMinus,
        TableLayout,
        XCircle
      } from '@boxicons/js';
      import { configureFeatureFlags, primeFeatureFlags } from '../lib/feature-flags';

      const mountIcons = () => {
        getIcons({
          icons: {
            Moon,
            Sun,
            Github,
            Lock,
            Bolt,
            MobileAlt,
            QrScan,
            Crop,
            Database,
            Grid,
            ImageSparkle,
            Clock,
            ImageNoBackground,
            Eyedropper,
            PlusMinus,
            TableLayout,
            XCircle
          }
        });
      };

      const runtimeLdClientId =
        (window.__toolbeltConfig && typeof window.__toolbeltConfig.ldClientId === 'string'
          ? window.__toolbeltConfig.ldClientId
          : '') || '';

      configureFeatureFlags({ ldClientId: runtimeLdClientId });
      void primeFeatureFlags();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountIcons, { once: true });
      } else {
        mountIcons();
      }
    </script>
    <div class="app-frame">
      <header
        class:list={['site-header', isHomeRoute && 'site-header--home']}
        aria-label={translate('shell.header.aria')}
      >
        <div class="ui-page site-header-inner">
          <button
            class="mobile-nav-toggle"
            type="button"
            data-mobile-nav-toggle
            aria-controls="site-primary-nav"
            aria-expanded="false"
            aria-label="Open navigation menu"
            title="Open navigation menu"
          >
            <span class="mobile-nav-toggle-bar" aria-hidden="true"></span>
            <span class="mobile-nav-toggle-bar" aria-hidden="true"></span>
            <span class="mobile-nav-toggle-bar" aria-hidden="true"></span>
            <i class="mobile-nav-close-icon" data-bx="x-circle" aria-hidden="true"></i>
          </button>

          <a href={localizeAppLink('/', locale)} class="brand">toolbelt.sh</a>

          <nav id="site-primary-nav" class="site-nav" aria-label={translate('shell.nav.primaryAria')} data-mobile-nav>
            {
              coreNavItems.map((item) => (
                <a
                  href={localizeAppLink(item.href, locale)}
                  class={`nav-link ${isNavActive(item.href, item.matches) ? 'nav-link--active' : ''}`.trim()}
                >
                  {item.label}
                </a>
              ))
            }

            {
              toolSections.map((section, index) => (
                <div class={`nav-group ${isSectionActive(section) ? 'nav-group--active' : ''}`.trim()}>
                  <button
                    class="nav-group-trigger"
                    type="button"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls={`nav-menu-${index}`}
                  >
                    {getLocalizedToolSectionTitle(locale, section.id, section.title)}
                    <span class="nav-caret" aria-hidden="true">▾</span>
                  </button>

                  <div
                    id={`nav-menu-${index}`}
                    class="nav-menu"
                    role="menu"
                    aria-label={`${getLocalizedToolSectionTitle(locale, section.id, section.title)} tools`}
                  >
                    {section.tools.map((tool) => {
                      const localizedTool = getLocalizedToolText(locale, tool.href, tool.name, tool.description);

                      return (
                        <a
                          href={localizeAppLink(tool.href, locale)}
                          role="menuitem"
                          class={`nav-menu-link ${isToolActive(tool.href) ? 'nav-menu-link--active' : ''}`.trim()}
                        >
                          <span class="nav-menu-icon" aria-hidden="true">
                            <i data-bx={boxIconByToolIcon[tool.icon]} data-bx-size="xs"></i>
                          </span>
                          <span class="nav-menu-copy">
                            <span class="nav-menu-title">{localizedTool.name}</span>
                            <span class="nav-menu-desc">{localizedTool.description}</span>
                          </span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </nav>

          <div class="header-actions">
            <div class="locale-switcher-wrap">
              <label class="sr-only" for="header-locale-switcher">
                {translate('shell.localeSwitcher.label')}
              </label>
              <select
                id="header-locale-switcher"
                class="locale-switcher"
                aria-label={translate('shell.localeSwitcher.label')}
                data-locale-switcher
              >
                {
                  localeOptions.map((option) => (
                    <option
                      value={option.code}
                      data-path={option.href}
                      selected={option.code === locale}
                    >
                      {option.label}
                    </option>
                  ))
                }
              </select>
            </div>

            <button class="theme-toggle" type="button" data-mode-toggle aria-label="Toggle theme">
              <i class="icon icon-moon" data-bx="moon" aria-hidden="true"></i>
              <i class="icon icon-sun" data-bx="sun" aria-hidden="true"></i>
            </button>

            <a class="github-link" href={githubUrl} target="_blank" rel="noreferrer">
              <i class="github-mark" data-bx="github" data-bx-pack="brands" aria-hidden="true"></i>
              <span>{translate('shell.github')}</span>
            </a>
          </div>
        </div>
      </header>
      <button
        class="mobile-nav-backdrop"
        type="button"
        data-mobile-nav-backdrop
        aria-label="Close navigation menu"
        tabindex="-1"
      ></button>

      <slot />

      <footer class="site-footer">
        <div class="ui-page site-footer-inner">
          <p class="site-footer-version">{translate('shell.footer.version')} {appVersion}</p>
        </div>
      </footer>
    </div>
    <Analytics />
    <SpeedInsights />
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    isolation: isolate;
    backdrop-filter: none;
    background: transparent;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .site-header-inner {
    min-height: 0;
    position: relative;
    z-index: 1;
    width: auto;
    max-width: none;
    margin-inline: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
