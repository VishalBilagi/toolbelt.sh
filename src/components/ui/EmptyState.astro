---
interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<section class={`ui-empty-state ${className}`.trim()}>
  {title && <h3>{title}</h3>}
  {description && <p>{description}</p>}
  <slot />
</section>
