---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { localizeAppLink, resolveLocaleFromPathname } from '../i18n';
import { secretMessages } from '../tools/secret-link/messages';

interface Props { mode: 'create' | 'decrypt' }
const { mode } = Astro.props;
const creating = mode === 'create';
const locale = resolveLocaleFromPathname(Astro.url.pathname);
const copy = secretMessages[locale];
---
<div class:list={['secret-workspace', { 'secret-workspace--unlock': !creating }]} data-secret-tool data-mode={mode} data-copy={JSON.stringify(copy)} data-decrypt-path={localizeAppLink('/tools/decrypt', locale)}>
  <header class="secret-intro">
    <span class="secret-badge"><Icon name="lock" size={16} />{copy.badge}</span>
    <p class="secret-eyebrow">{copy.title}</p>
    <h1>{creating ? copy.description : copy.unlockTitle}</h1>
    <p>{creating ? copy.intro : copy.unlockIntro}</p>
  </header>
  <nav class="secret-tabs" aria-label={copy.title}>
    <a href={localizeAppLink('/tools/secret-link', locale)} aria-current={creating ? 'page' : undefined}>{copy.createTab}</a>
    <a href={localizeAppLink('/tools/decrypt', locale)} aria-current={!creating ? 'page' : undefined}>{copy.unlockTab}</a>
  </nav>
  <noscript><p class="secret-notice">{copy.noScript}</p></noscript>
  <div class="secret-grid">
    <div class="secret-editor">
      {creating ? (
        <form id="secret-form" autocomplete="off">
          <fieldset id="secret-controls" disabled>
            <div class="secret-field">
              <label class="secret-section-label" for="secret-message">{copy.message}</label>
              <textarea id="secret-message" class="ui-textarea secret-message" rows="7" maxlength="1024" placeholder={copy.placeholder} aria-describedby="secret-count secret-limit" spellcheck="false" autocomplete="off" autocapitalize="off" required />
              <div class="secret-meter"><small id="secret-limit">{copy.limit}</small><output id="secret-count" for="secret-message">0 / 1,024 {copy.bytes}</output></div>
            </div>
            <div class="secret-field">
              <label class="secret-section-label" for="secret-passphrase">{copy.phrase}</label>
              <div class="secret-input-row">
                <input id="secret-passphrase" class="ui-input secret-phrase" type="password" maxlength="1024" autocomplete="new-password" spellcheck="false" autocapitalize="off" aria-describedby="secret-phrase-hint" required />
                <Button id="secret-reveal" variant="secondary" aria-controls="secret-passphrase" aria-pressed="false">{copy.show}</Button>
              </div>
              <small id="secret-phrase-hint">{copy.phraseHint}</small>
              <div id="secret-confirm-wrap" class="secret-field" hidden>
                <label for="secret-confirm">{copy.confirm}</label>
                <input id="secret-confirm" class="ui-input" type="password" maxlength="1024" autocomplete="new-password" spellcheck="false" autocapitalize="off" />
              </div>
              <div class="secret-actions">
                <Button id="secret-generate" variant="secondary" size="sm">{copy.regenerate}</Button>
                <Button id="secret-copy-phrase" variant="ghost" size="sm">{copy.copyPhrase}</Button>
              </div>
            </div>
            <Button id="secret-submit" type="submit" fullWidth>{copy.create} <span aria-hidden="true">→</span></Button>
          </fieldset>
        </form>
      ) : (
        <>
          <form id="secret-load-form" autocomplete="off">
            <fieldset id="secret-load-controls" disabled>
              <p id="secret-load-hint">{copy.empty}</p>
              <label for="secret-source">{copy.pasteLabel}</label>
              <textarea id="secret-source" class="ui-textarea secret-url" rows="3" maxlength="4096" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="secret-paste-hint" required />
              <small id="secret-paste-hint">{copy.pasteHint}</small>
              <Button type="submit" variant="secondary">{copy.load}</Button>
            </fieldset>
          </form>
          <form id="secret-form" autocomplete="off" hidden>
            <fieldset id="secret-controls" disabled>
              <div class="secret-lock-icon"><Icon name="lock" size={28} /></div>
              <p>{copy.loaded}</p>
              <div class="secret-field">
                <label for="secret-passphrase">{copy.phraseLabel}</label>
                <div class="secret-input-row">
                  <input id="secret-passphrase" class="ui-input secret-phrase" type="password" maxlength="1024" autocomplete="off" spellcheck="false" autocapitalize="off" aria-describedby="secret-phrase-hint" required />
                  <Button id="secret-reveal" variant="secondary" aria-controls="secret-passphrase" aria-pressed="false">{copy.show}</Button>
                </div>
                <small id="secret-phrase-hint">{copy.exact}</small>
              </div>
              <Button id="secret-submit" type="submit" fullWidth>{copy.unlock}</Button>
            </fieldset>
          </form>
        </>
      )}
      <p id="secret-status" class="secret-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <section id="secret-result" class="secret-result" aria-labelledby="secret-result-title" hidden>
        <h2 id="secret-result-title" tabindex="-1">{creating ? copy.ready : copy.openReady}</h2>
        {creating && <p>{copy.readyHint}</p>}
        <label for="secret-output">{creating ? copy.linkLabel : copy.decrypted}</label>
        <textarea id="secret-output" class:list={['ui-textarea', creating ? 'secret-url' : 'secret-message']} rows={creating ? 3 : 7} readonly spellcheck="false" autocomplete="off" />
        <div class="secret-actions">
          <Button id="secret-copy-output">{creating ? copy.copyLink : copy.copyMessage}</Button>
          {!creating && <Button id="secret-lock" variant="secondary">{copy.lock}</Button>}
        </div>
      </section>
      <Button id="secret-clear" variant="ghost">{copy.clear}</Button>
    </div>
    <aside class="secret-aside">
      <div class="secret-lock-icon"><Icon name="lock" size={24} /></div>
      <h2>{copy.howTitle}</h2>
      <ol>
        <li>{copy.howLink}</li>
        <li>{copy.howPhrase}</li>
      </ol>
      <p class="secret-local">{copy.howLocal}</p>
      <p>{copy.caveat}</p>
    </aside>
  </div>
  <details class="secret-details">
    <summary>{copy.more}</summary>
    <p>{copy.details}</p>
    <p>{copy.trust}</p>
    <p>{copy.attribution} <a href="https://www.eff.org/dice" target="_blank" rel="noopener noreferrer">EFF ↗</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0 ↗</a></p>
  </details>
</div>
<script>
  import { initSecretLink } from '../tools/secret-link/client';
  initSecretLink();
</script>
<style>
  .secret-workspace { max-width: 68rem; margin: auto; padding: var(--space-3xl) var(--space-xl); }
  .secret-intro { max-width: 43rem; margin-bottom: var(--space-2xl); }
  .secret-badge { display: inline-flex; align-items: center; gap: var(--space-sm); background: var(--color-success-soft); color: var(--color-success); border: 1px solid var(--color-success-border); border-radius: var(--radius-full); padding: .3rem .65rem; font-size: .75rem; font-weight: 650; margin-bottom: var(--space-xl); }
  .secret-eyebrow { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; margin-bottom: var(--space-sm); }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: var(--space-lg); }
  h2 { font-size: 1.1rem; }
  .secret-tabs { display: flex; gap: var(--space-xl); border-bottom: 1px solid var(--border-default); margin-bottom: var(--space-xl); }
  .secret-tabs a { color: var(--text-secondary); padding: var(--space-md) 0; border-bottom: 2px solid transparent; }
  .secret-tabs a[aria-current] { color: var(--accent); border-color: var(--accent); font-weight: 650; }
  .secret-grid { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: var(--space-xl); align-items: start; }
  .secret-editor { min-width: 0; background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: var(--space-xl); }
  fieldset { display: grid; gap: var(--space-xl); border: 0; padding: 0; margin: 0; min-width: 0; }
  .secret-field { display: grid; gap: var(--space-sm); min-width: 0; }
  label { font-size: .85rem; font-weight: 650; }
  .secret-section-label { font-size: .95rem; }
  .secret-input-row { display: flex; gap: var(--space-sm); align-items: center; }
  .secret-input-row input { min-width: 0; flex: 1; }
  .secret-phrase { font-family: var(--font-mono); font-size: .85rem; }
  textarea { width: 100%; resize: vertical; }
  .secret-message { line-height: 1.7; font-size: 1rem; }
  .secret-meter { display: flex; gap: var(--space-lg); justify-content: space-between; align-items: start; }
  small, output { font-size: .75rem; color: var(--text-secondary); }
  output { white-space: nowrap; font-variant-numeric: tabular-nums; }
  [aria-invalid='true'], .secret-status[data-error='true'] { color: var(--state-danger); }
  .secret-actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
  .secret-aside { padding: var(--space-xl) var(--space-sm); font-size: .85rem; }
  .secret-aside h2 { margin: var(--space-lg) 0; line-height: 1.4; }
  .secret-aside ol { padding-left: var(--space-xl); color: var(--text-secondary); }
  .secret-aside li + li { margin-top: var(--space-md); }
  .secret-local { border-top: 1px solid var(--border-default); padding-top: var(--space-lg); margin-top: var(--space-xl); margin-bottom: var(--space-md); color: var(--color-success); font-weight: 600; }
  .secret-lock-icon { background: var(--accent-muted); color: var(--accent); display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: var(--radius-md); }
  .secret-status { margin-block: var(--space-lg); font-size: .85rem; overflow-wrap: anywhere; }
  .secret-status:empty { margin-block: var(--space-sm); }
  .secret-result { display: grid; gap: var(--space-md); padding: var(--space-xl) 0; margin-bottom: var(--space-lg); border-top: 1px solid var(--color-success-border); }
  .secret-result h2 { color: var(--color-success); }
  .secret-result p { font-size: .85rem; }
  .secret-url { font-family: var(--font-mono); font-size: .75rem; overflow-wrap: anywhere; word-break: break-all; }
  .secret-details { padding-block: var(--space-xl); color: var(--text-secondary); font-size: .8rem; }
  .secret-details summary { cursor: pointer; font-weight: 600; }
  .secret-details p { margin-top: var(--space-md); max-width: 54rem; }
  .secret-notice { padding: var(--space-lg); background: var(--color-warning-soft); margin-bottom: var(--space-lg); }
  [hidden] { display: none !important; }
  @media (max-width: 760px) { .secret-grid { grid-template-columns: 1fr; } .secret-aside { padding-top: var(--space-sm); } .secret-workspace { padding-top: var(--space-xl); } }
  @media (max-width: 420px) { .secret-workspace { padding-inline: var(--space-lg); } .secret-editor { padding: var(--space-lg); } .secret-meter { flex-direction: column; gap: var(--space-xs); } }
</style>
