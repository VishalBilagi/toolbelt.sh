---
import { toolSections, totalToolCount } from '../data/tool-directory';
import Icon from './ui/Icon.astro';
import { createTranslator, getLocalizedToolSectionTitle, getLocalizedToolText, localizeAppLink, resolveLocaleFromPathname } from '../i18n';
interface Props { sectionId?: string; }
const { sectionId = 'tools' } = Astro.props;
const locale = resolveLocaleFromPathname(Astro.url.pathname);
const t = createTranslator(locale);
---
<section id={sectionId} class="tools-section" data-directory data-result-template={t('workbench.results', { count: '{count}' })} aria-label={t('toolDirectory.aria')}>
  <div class="tools-head"><div><h2>{t('shell.nav.allTools')}<span class="count-badge">{totalToolCount}</span></h2><p>{t('workbench.toolsIntro')}</p></div><span class="tools-head-note"><span class="status-dot"></span>{t('workbench.localOnly')}</span></div>
  <div class="directory-search"><Icon name="search" /><label class="visually-hidden" for="tool-search">{t('workbench.search')}</label><input id="tool-search" type="search" placeholder={t('workbench.searchHint')} autocomplete="off" /><kbd>/</kbd></div>
  <div class="directory-toolbar"><div class="category-filters" role="group" aria-label={t('workbench.filter')}>
    <button type="button" class="category-filter is-active" data-category="all" aria-pressed="true">{t('workbench.all')}<span>{totalToolCount}</span></button>
    {toolSections.map(section => <button type="button" class="category-filter" data-category={section.id} aria-pressed="false">{getLocalizedToolSectionTitle(locale, section.id, section.title)}</button>)}
    <button type="button" class="category-filter" data-category="saved" aria-pressed="false"><Icon name="star" />{t('workbench.saved')}</button>
  </div><span class="results-count" data-results-count aria-live="polite" aria-atomic="true">{t('workbench.results', { count: totalToolCount })}</span></div>
  <div class="tools-grid">
    {toolSections.flatMap(section => section.tools.map(tool => {
      const copy = getLocalizedToolText(locale, tool.href, tool.name, tool.description);
      return <article class="tool-card" data-tool-card data-tool={tool.href} data-section={section.id} data-search={`${copy.name} ${copy.description} ${tool.name} ${tool.tags.join(' ')}`}>
        <a href={localizeAppLink(tool.href, locale)} class="tool-card-link" aria-label={t('toolDirectory.openTool', { name: copy.name })}>
          <span class="tool-icon"><Icon name={tool.icon} /></span>
          <h3>{copy.name}</h3><p>{copy.description}</p>
          <div class="tool-card-foot"><span>{getLocalizedToolSectionTitle(locale, section.id, section.title)}</span><Icon name="arrow-up-right" /></div>
        </a>
        <button type="button" class="favorite-button" data-favorite={tool.href} aria-pressed="false" aria-label={t('workbench.favorite', { name: copy.name })} title={t('workbench.favorite', { name: copy.name })}><Icon name="star" /></button>
      </article>;
    }))}
  </div>
  <div class="directory-empty" data-directory-empty hidden><Icon name="search" /><h3 data-empty-title data-default={t('workbench.noResults')} data-saved={t('workbench.noSaved')}>{t('workbench.noResults')}</h3><p data-empty-body data-default={t('workbench.noResultsBody')} data-saved={t('workbench.noSavedBody')}>{t('workbench.noResultsBody')}</p><button class="ui-button ui-button--secondary" type="button" data-reset-filters>{t('workbench.clear')}</button></div>
</section>
<script>
  import { initDirectory } from '../lib/workbench';
  initDirectory();
</script>
