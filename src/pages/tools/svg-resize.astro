---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Field from '../../components/ui/Field.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
---

<ToolLayout title="SVG Resizer">
  <section class="tool-grid">
    <div class="tool-column">
      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">Precision Resize Controls</h2>
            <p class="ui-card__description">Upload an SVG, resize with presets or exact values, then export as SVG, PNG, or JPEG.</p>
          </div>
          <Badge tone="neutral">Client-side</Badge>
        </div>

        <Field label="SVG file" htmlFor="svg-file" hint="Dimensions are read from viewBox first, then width/height attributes.">
          <Input id="svg-file" type="file" accept=".svg,image/svg+xml" />
        </Field>

        <p class="cross-tool-link">Need photo-style editing (crop, rotate, flip, format convert)? <a href="/tools/image-editor">Open Image Editor Basics</a>.</p>

        <div class="meta-strip">
          <p id="file-name" class="meta-text">No SVG loaded.</p>
          <p id="dimension-source" class="meta-text">Dimension source: -</p>
        </div>

        <div class="section-block">
          <div class="section-heading">
            <h3>Quick Scale Presets</h3>
            <p>Fast common export sizes.</p>
          </div>
          <div class="preset-row" id="preset-row">
            <button class="ui-button ui-button--ghost ui-button--sm preset-btn" type="button" data-scale="0.5">0.5x</button>
            <button class="ui-button ui-button--ghost ui-button--sm preset-btn" type="button" data-scale="1">1x</button>
            <button class="ui-button ui-button--ghost ui-button--sm preset-btn" type="button" data-scale="2">2x</button>
            <button class="ui-button ui-button--ghost ui-button--sm preset-btn" type="button" data-scale="3">3x</button>
            <button class="ui-button ui-button--ghost ui-button--sm preset-btn" type="button" data-scale="4">4x</button>
          </div>
        </div>

        <div class="section-block">
          <div class="section-heading">
            <h3>Custom Scale</h3>
            <p>Precision-first controls with optional slider for quick exploration.</p>
          </div>

          <div class="field-grid two-col">
            <Field label="Scale (x)" htmlFor="scale-input">
              <Input id="scale-input" type="number" min="0.1" max="100" step="0.01" value="1" inputmode="decimal" />
            </Field>
            <Field label="Scale (%)" htmlFor="percent-input">
              <Input id="percent-input" type="number" min="10" max="10000" step="1" value="100" inputmode="decimal" />
            </Field>
          </div>

          <Field label="Preview Slider (secondary control)" htmlFor="scale-slider" hint="Range: 0.1x to 10x. Use numeric fields for exact values.">
            <div class="slider-row">
              <input id="scale-slider" type="range" min="0.1" max="10" step="0.01" value="1" />
              <p id="slider-scale-label" class="slider-value">1x</p>
            </div>
          </Field>
        </div>

        <div class="section-block">
          <div class="section-heading">
            <h3>Output Dimensions</h3>
            <p>Aspect ratio lock is always on to avoid distortion.</p>
          </div>
          <div class="field-grid two-col">
            <Field label="Width (px)" htmlFor="width-input">
              <Input id="width-input" type="number" min="1" max="8192" step="1" value="1" inputmode="numeric" />
            </Field>
            <Field label="Height (px)" htmlFor="height-input">
              <Input id="height-input" type="number" min="1" max="8192" step="1" value="1" inputmode="numeric" />
            </Field>
          </div>
        </div>
      </Card>

      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">Export Settings</h2>
            <p class="ui-card__description">Vector export preserves viewBox. Raster export renders at the calculated output size.</p>
          </div>
        </div>

        <div class="field-grid">
          <Field label="Format" htmlFor="format-select">
            <Select id="format-select">
              <option value="svg">SVG</option>
              <option value="png">PNG</option>
              <option value="jpeg">JPEG</option>
            </Select>
          </Field>

          <div id="jpeg-controls" class="conditional-panel" hidden>
            <Field label="JPEG Quality" htmlFor="jpeg-quality">
              <div class="slider-row">
                <input id="jpeg-quality" type="range" min="50" max="100" step="1" value="90" />
                <p id="jpeg-quality-label" class="slider-value">90</p>
              </div>
            </Field>

            <Field label="Background Color" htmlFor="jpeg-bg" hint="JPEG does not support transparency, so transparent regions are flattened.">
              <div class="color-row">
                <input id="jpeg-bg" type="color" value="#ffffff" />
                <Input id="jpeg-bg-text" type="text" value="#ffffff" />
              </div>
            </Field>
          </div>

          <div id="png-controls" class="conditional-panel" hidden>
            <label class="inline-checkbox">
              <input id="png-flatten" type="checkbox" />
              <span>Flatten PNG transparency with background color (optional)</span>
            </label>

            <div id="png-bg-wrap" hidden>
              <Field label="PNG Background Color" htmlFor="png-bg">
                <div class="color-row">
                  <input id="png-bg" type="color" value="#ffffff" />
                  <Input id="png-bg-text" type="text" value="#ffffff" />
                </div>
              </Field>
            </div>
          </div>

          <div id="svg-controls" class="conditional-panel">
            <p class="help-inline">SVG export updates <code>width</code>/<code>height</code> and keeps the original <code>viewBox</code> intact.</p>
            <p class="help-inline">Android XML asset download saves the same SVG XML markup with a <code>.xml</code> filename (not a VectorDrawable conversion).</p>
          </div>
        </div>

        <div class="summary-box">
          <p id="size-summary">Original: - → Output: -</p>
          <p id="ratio-summary">Scale: -</p>
          <p id="megapixel-summary">Megapixels: -</p>
        </div>

        <div id="guardrail-messages" class="notice-stack" aria-live="polite"></div>
        <p id="export-status" class="export-status" aria-live="polite"></p>

        <div class="actions">
          <Button id="download-primary" variant="primary">Download</Button>
          <Button id="download-svg-xml" variant="secondary">Download Android XML (.xml)</Button>
          <Button href="/tools" variant="ghost" size="sm">Back to tools</Button>
        </div>
      </Card>
    </div>

    <div class="tool-column">
      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">Live Preview</h2>
            <p class="ui-card__description">Preview is visually fit to the UI, but labels always show real output pixel dimensions.</p>
          </div>
        </div>

        <label class="inline-checkbox">
          <input id="checkerboard-toggle" type="checkbox" checked />
          <span>Transparency checkerboard background</span>
        </label>

        <div class="preview-grid">
          <section class="preview-panel">
            <div class="preview-head">
              <h3>Before</h3>
              <p id="before-dims">-</p>
            </div>
            <div id="before-stage" class="preview-stage checkerboard">
              <img id="before-preview" alt="Original SVG preview" hidden />
              <p id="before-placeholder" class="preview-placeholder">Upload an SVG to preview it.</p>
            </div>
          </section>

          <section class="preview-panel">
            <div class="preview-head">
              <h3>After</h3>
              <p id="after-dims">-</p>
            </div>
            <div id="after-stage" class="preview-stage checkerboard">
              <img id="after-preview" alt="Resized SVG preview" hidden />
              <p id="after-placeholder" class="preview-placeholder">Resized preview will update automatically.</p>
            </div>
            <div class="preview-meta">
              <p id="after-scale">Scale ratio: -</p>
              <p id="after-actual">Actual output size: -</p>
            </div>
          </section>
        </div>
      </Card>

      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">SVG Info</h2>
            <p class="ui-card__description">Source dimensions and parsing details from the uploaded SVG.</p>
          </div>
        </div>
        <div class="info-grid">
          <p><span>Original size</span><strong id="info-original-size">-</strong></p>
          <p><span>Aspect ratio</span><strong id="info-aspect">-</strong></p>
          <p><span>Dimension source</span><strong id="info-source">-</strong></p>
          <p><span>viewBox</span><strong id="info-viewbox">-</strong></p>
        </div>
      </Card>

    </div>
  </section>
</ToolLayout>

<style>
  :global(main.tool-content) {
    width: min(100%, 96rem) !important;
    max-width: min(100%, 96rem) !important;
  }

  .tool-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: start;
  }

  .tool-column {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
    min-width: 0;
  }

  .field-grid {
    display: grid;
    gap: var(--space-md);
  }

  .field-grid.two-col {
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .meta-strip {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-xs);
  }

  .cross-tool-link {
    margin-top: var(--space-md);
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  .cross-tool-link a {
    color: var(--accent-500);
  }

  .meta-text {
    color: var(--text-secondary);
    font-size: 0.86rem;
    word-break: break-word;
  }

  .section-block {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-default);
    display: grid;
    gap: var(--space-md);
  }

  .section-heading h3 {
    font-size: 0.98rem;
  }

  .section-heading p {
    margin-top: 0.2rem;
    color: var(--text-secondary);
    font-size: 0.84rem;
  }

  .preset-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .preset-btn[data-active='true'] {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--bg-inset) 78%, transparent);
  }

  .slider-row {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .slider-row input[type='range'] {
    width: 100%;
  }

  .slider-value {
    min-width: 3.6rem;
    text-align: right;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  .lock-row {
    display: grid;
    gap: var(--space-xs);
  }

  .lock-note {
    color: var(--text-secondary);
    font-size: 0.82rem;
  }

  .conditional-panel {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: color-mix(in srgb, var(--bg-inset) 78%, transparent);
  }

  .help-inline {
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .color-row {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
  }

  .color-row input[type='color'] {
    width: 2.75rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .inline-checkbox {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  .summary-box {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: color-mix(in srgb, var(--bg-inset) 82%, transparent);
    display: grid;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  .notice-stack {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  :global(.notice-stack .notice) {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.84rem;
    line-height: 1.35;
  }

  :global(.notice-stack .notice.warning) {
    background: color-mix(in srgb, var(--warning-soft, #f9d976) 16%, transparent);
    border-color: color-mix(in srgb, var(--warning-soft, #f9d976) 36%, var(--border-default));
  }

  :global(.notice-stack .notice.error) {
    background: color-mix(in srgb, #ff6b6b 10%, transparent);
    border-color: color-mix(in srgb, #ff6b6b 30%, var(--border-default));
  }

  .export-status {
    margin-top: var(--space-md);
    min-height: 1.2rem;
    color: var(--text-secondary);
    font-size: 0.84rem;
  }

  .actions {
    margin-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .preview-grid {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
  }

  .preview-panel {
    display: grid;
    gap: var(--space-sm);
  }

  .preview-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: baseline;
  }

  .preview-head h3 {
    font-size: 0.96rem;
  }

  .preview-head p {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .preview-stage {
    min-height: 220px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: color-mix(in srgb, var(--bg-inset) 82%, transparent);
    display: grid;
    place-items: center;
    padding: var(--space-md);
    position: relative;
    overflow: hidden;
  }

  .preview-stage.checkerboard {
    background-image:
      linear-gradient(45deg, color-mix(in srgb, var(--bg-inset) 92%, black 8%) 25%, transparent 25%),
      linear-gradient(-45deg, color-mix(in srgb, var(--bg-inset) 92%, black 8%) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, color-mix(in srgb, var(--bg-inset) 92%, black 8%) 75%),
      linear-gradient(-45deg, transparent 75%, color-mix(in srgb, var(--bg-inset) 92%, black 8%) 75%);
    background-size: 24px 24px;
    background-position: 0 0, 0 12px, 12px -12px, -12px 0;
  }

  .preview-stage img {
    max-width: 100%;
    max-height: 300px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: var(--radius-sm);
  }

  .preview-placeholder {
    color: var(--text-tertiary);
    text-align: center;
    font-size: 0.9rem;
  }

  .preview-meta {
    display: grid;
    gap: var(--space-xs);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .info-grid {
    display: grid;
    gap: var(--space-sm);
  }

  .info-grid p {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border-subtle, var(--border-default));
  }

  .info-grid p:last-child {
    border-bottom: 0;
  }

  .info-grid span {
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .info-grid strong {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    word-break: break-word;
  }

  @media (max-width: 1100px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { APP_FEATURE_FLAGS, getBooleanFeatureFlag, subscribeBooleanFeatureFlag } from '../../lib/feature-flags';

  const svgFileInput = document.getElementById('svg-file') as HTMLInputElement | null;
  const fileNameEl = document.getElementById('file-name');
  const dimensionSourceEl = document.getElementById('dimension-source');

  const scaleInput = document.getElementById('scale-input') as HTMLInputElement | null;
  const percentInput = document.getElementById('percent-input') as HTMLInputElement | null;
  const scaleSlider = document.getElementById('scale-slider') as HTMLInputElement | null;
  const sliderScaleLabel = document.getElementById('slider-scale-label');
  const widthInput = document.getElementById('width-input') as HTMLInputElement | null;
  const heightInput = document.getElementById('height-input') as HTMLInputElement | null;

  const formatSelect = document.getElementById('format-select') as HTMLSelectElement | null;
  const svgControls = document.getElementById('svg-controls');
  const pngControls = document.getElementById('png-controls');
  const jpegControls = document.getElementById('jpeg-controls');

  const pngFlatten = document.getElementById('png-flatten') as HTMLInputElement | null;
  const pngBgWrap = document.getElementById('png-bg-wrap');
  const pngBg = document.getElementById('png-bg') as HTMLInputElement | null;
  const pngBgText = document.getElementById('png-bg-text') as HTMLInputElement | null;

  const jpegQuality = document.getElementById('jpeg-quality') as HTMLInputElement | null;
  const jpegQualityLabel = document.getElementById('jpeg-quality-label');
  const jpegBg = document.getElementById('jpeg-bg') as HTMLInputElement | null;
  const jpegBgText = document.getElementById('jpeg-bg-text') as HTMLInputElement | null;

  const sizeSummaryEl = document.getElementById('size-summary');
  const ratioSummaryEl = document.getElementById('ratio-summary');
  const megapixelSummaryEl = document.getElementById('megapixel-summary');
  const guardrailMessagesEl = document.getElementById('guardrail-messages');
  const exportStatusEl = document.getElementById('export-status');

  const checkerboardToggle = document.getElementById('checkerboard-toggle') as HTMLInputElement | null;
  const beforeStage = document.getElementById('before-stage');
  const afterStage = document.getElementById('after-stage');
  const beforePreview = document.getElementById('before-preview') as HTMLImageElement | null;
  const afterPreview = document.getElementById('after-preview') as HTMLImageElement | null;
  const beforePlaceholder = document.getElementById('before-placeholder');
  const afterPlaceholder = document.getElementById('after-placeholder');
  const beforeDimsEl = document.getElementById('before-dims');
  const afterDimsEl = document.getElementById('after-dims');
  const afterScaleEl = document.getElementById('after-scale');
  const afterActualEl = document.getElementById('after-actual');

  const infoOriginalSizeEl = document.getElementById('info-original-size');
  const infoAspectEl = document.getElementById('info-aspect');
  const infoSourceEl = document.getElementById('info-source');
  const infoViewBoxEl = document.getElementById('info-viewbox');

  const downloadPrimaryBtn = document.getElementById('download-primary') as HTMLButtonElement | null;
  const downloadSvgXmlBtn = document.getElementById('download-svg-xml') as HTMLButtonElement | null;

  type SvgResizeLogic = typeof import('../../tools/svg-resize/logic');
  let svgResizeLogic: SvgResizeLogic | null = null;

  const getLogic = async () => {
    if (!svgResizeLogic) {
      svgResizeLogic = await import('../../tools/svg-resize/logic');
    }
    return svgResizeLogic;
  };

  type LoadedSvgState = {
    text: string;
    fileName: string;
    originalUrl: string;
    dimensions: Awaited<ReturnType<typeof getLogic>> extends infer T
      ? T extends { parseSvgDimensions: (...args: any[]) => infer R }
        ? R
        : never
      : never;
  };

  const state: {
    loaded: LoadedSvgState | null;
    outputWidth: number;
    outputHeight: number;
    scale: number;
    previewUrl: string | null;
    previewTimer: number | null;
    previewRequestId: number;
    androidXmlEnabled: boolean;
    androidXmlFlagUnsubscribe: (() => void) | null;
  } = {
    loaded: null,
    outputWidth: 1,
    outputHeight: 1,
    scale: 1,
    previewUrl: null,
    previewTimer: null,
    previewRequestId: 0,
    androidXmlEnabled: false,
    androidXmlFlagUnsubscribe: null
  };

  const setExportStatus = (value: string) => {
    if (exportStatusEl) exportStatusEl.textContent = value;
  };

  const revokePreviewUrl = () => {
    if (state.previewUrl) {
      URL.revokeObjectURL(state.previewUrl);
      state.previewUrl = null;
    }
  };

  const downloadBlob = (blob: Blob, filename: string) => {
    const href = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = href;
    link.download = filename;
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(href), 1000);
  };

  const slugifyBaseName = (name: string) => {
    const stripped = name.replace(/\.[^.]+$/, '');
    const cleaned = stripped
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9._-]+/g, '-')
      .replace(/^-+|-+$/g, '');
    return cleaned || 'asset';
  };

  const getCurrentFormat = (): 'svg' | 'png' | 'jpeg' => {
    const value = formatSelect?.value ?? 'svg';
    return value === 'png' || value === 'jpeg' ? value : 'svg';
  };

  const getNormalizedColorValue = (textValue: string | undefined, pickerValue: string | undefined, fallback: string) =>
    normalizeHexColor(textValue ?? '') ?? normalizeHexColor(pickerValue ?? '') ?? fallback;

  const getEffectiveBackgroundColor = (format: 'svg' | 'png' | 'jpeg'): string | null => {
    if (format === 'jpeg') {
      return getNormalizedColorValue(jpegBgText?.value, jpegBg?.value, '#ffffff');
    }
    if (format === 'png' && pngFlatten?.checked) {
      return getNormalizedColorValue(pngBgText?.value, pngBg?.value, '#ffffff');
    }
    return null;
  };

  const syncColorInputs = (colorInput: HTMLInputElement | null, textInput: HTMLInputElement | null) => {
    if (!colorInput || !textInput) return;
    colorInput.addEventListener('input', () => {
      textInput.value = colorInput.value;
    });
    textInput.addEventListener('change', () => {
      const normalized = normalizeHexColor(textInput.value);
      if (normalized) {
        textInput.value = normalized;
        colorInput.value = normalized;
      } else {
        textInput.value = colorInput.value;
      }
    });
  };

  const normalizeHexColor = (value: string): string | null => {
    const trimmed = value.trim();
    if (/^#[0-9a-f]{6}$/i.test(trimmed)) return trimmed.toLowerCase();
    if (/^#[0-9a-f]{3}$/i.test(trimmed)) {
      const r = trimmed[1];
      const g = trimmed[2];
      const b = trimmed[3];
      return `#${r}${r}${g}${g}${b}${b}`.toLowerCase();
    }
    return null;
  };

  const setCheckerboard = (enabled: boolean) => {
    for (const el of [beforeStage, afterStage]) {
      if (!el) continue;
      el.classList.toggle('checkerboard', enabled);
    }
  };

  const getOutputGuardrails = async () => {
    const logic = await getLogic();
    return logic.evaluateOutputGuardrails(state.outputWidth, state.outputHeight);
  };

  const renderGuardrailMessages = async () => {
    if (!guardrailMessagesEl) return;
    if (!state.loaded) {
      guardrailMessagesEl.innerHTML = '';
      return;
    }

    const guardrails = await getOutputGuardrails();
    const items = [
      ...guardrails.blocking.map((message) => ({ level: 'error', message })),
      ...guardrails.warnings.map((message) => ({ level: 'warning', message }))
    ];

    guardrailMessagesEl.innerHTML = items
      .map((item) => `<p class="notice ${item.level}">${item.message}</p>`)
      .join('');
  };

  const updatePresetButtons = () => {
    const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset-btn'));
    for (const button of presetButtons) {
      const presetScale = Number(button.dataset.scale);
      const active = Number.isFinite(presetScale) && Math.abs(presetScale - state.scale) < 0.005;
      button.dataset.active = active ? 'true' : 'false';
    }
  };

  const updateSummary = async () => {
    if (!state.loaded) {
      if (sizeSummaryEl) sizeSummaryEl.textContent = 'Original: - → Output: -';
      if (ratioSummaryEl) ratioSummaryEl.textContent = 'Scale: -';
      if (megapixelSummaryEl) megapixelSummaryEl.textContent = 'Megapixels: -';
      if (beforeDimsEl) beforeDimsEl.textContent = '-';
      if (afterDimsEl) afterDimsEl.textContent = '-';
      if (afterScaleEl) afterScaleEl.textContent = 'Scale ratio: -';
      if (afterActualEl) afterActualEl.textContent = 'Actual output size: -';
      return;
    }

    const logic = await getLogic();
    const original = state.loaded.dimensions;
    const guardrails = logic.evaluateOutputGuardrails(state.outputWidth, state.outputHeight);

    if (sizeSummaryEl) {
      sizeSummaryEl.textContent = `Original: ${logic.formatPixelSize(original.width, original.height)} → Output: ${logic.formatPixelSize(
        state.outputWidth,
        state.outputHeight
      )}`;
    }
    if (ratioSummaryEl) ratioSummaryEl.textContent = `Scale: ${logic.formatScaleRatio(state.scale)} (${logic.formatPercent(state.scale)})`;
    if (megapixelSummaryEl) megapixelSummaryEl.textContent = `Megapixels: ${logic.formatMegapixels(guardrails.megapixels)}`;

    if (beforeDimsEl) beforeDimsEl.textContent = logic.formatPixelSize(original.width, original.height);
    if (afterDimsEl) afterDimsEl.textContent = logic.formatPixelSize(state.outputWidth, state.outputHeight);
    if (afterScaleEl) afterScaleEl.textContent = `Scale ratio: ${logic.formatScaleRatio(state.scale)} (${logic.formatPercent(state.scale)})`;
    if (afterActualEl) afterActualEl.textContent = `Actual output size: ${logic.formatPixelSize(state.outputWidth, state.outputHeight)}`;
  };

  const updateControlFields = async () => {
    if (!state.loaded) return;
    const logic = await getLogic();

    if (scaleInput) scaleInput.value = state.scale.toFixed(4).replace(/\.?0+$/, '');
    if (percentInput) percentInput.value = (state.scale * 100).toFixed(2).replace(/\.?0+$/, '');
    if (widthInput) widthInput.value = String(state.outputWidth);
    if (heightInput) heightInput.value = String(state.outputHeight);
    if (scaleSlider) {
      const sliderValue = logic.clampScale(state.scale, 0.1, 10);
      scaleSlider.value = sliderValue.toFixed(2);
    }
    if (sliderScaleLabel) sliderScaleLabel.textContent = logic.formatScaleRatio(state.scale);
    updatePresetButtons();
  };

  const toggleFormatPanels = () => {
    const format = getCurrentFormat();
    if (svgControls) svgControls.hidden = format !== 'svg';
    if (pngControls) pngControls.hidden = format !== 'png';
    if (jpegControls) jpegControls.hidden = format !== 'jpeg';
    if (downloadSvgXmlBtn) downloadSvgXmlBtn.hidden = format !== 'svg' || !state.androidXmlEnabled;
    if (pngBgWrap) pngBgWrap.hidden = !(format === 'png' && !!pngFlatten?.checked);
  };

  const initAndroidXmlFlagGate = async () => {
    state.androidXmlEnabled = await getBooleanFeatureFlag(APP_FEATURE_FLAGS['android-xml-download'], false);
    toggleFormatPanels();
    console.log('Android XML download flag:', state.androidXmlEnabled);

    state.androidXmlFlagUnsubscribe?.();
    state.androidXmlFlagUnsubscribe = await subscribeBooleanFeatureFlag(
      APP_FEATURE_FLAGS['android-xml-download'],
      (value) => {
        state.androidXmlEnabled = value;
        toggleFormatPanels();
      },
      false
    );
  };

  const updateInfoPanel = async () => {
    if (!state.loaded) {
      if (infoOriginalSizeEl) infoOriginalSizeEl.textContent = '-';
      if (infoAspectEl) infoAspectEl.textContent = '-';
      if (infoSourceEl) infoSourceEl.textContent = '-';
      if (infoViewBoxEl) infoViewBoxEl.textContent = '-';
      return;
    }

    const logic = await getLogic();
    const { dimensions, fileName } = state.loaded;
    if (fileNameEl) fileNameEl.textContent = fileName;
    if (dimensionSourceEl)
      dimensionSourceEl.textContent = `Dimension source: ${dimensions.source === 'viewBox' ? 'viewBox (preferred)' : 'width/height attributes'}`;

    if (infoOriginalSizeEl) infoOriginalSizeEl.textContent = logic.formatPixelSize(dimensions.width, dimensions.height);
    if (infoAspectEl) infoAspectEl.textContent = dimensions.aspectRatio.toFixed(4).replace(/\.?0+$/, '');
    if (infoSourceEl) infoSourceEl.textContent = dimensions.source;
    if (infoViewBoxEl) {
      infoViewBoxEl.textContent = dimensions.viewBox
        ? `${dimensions.viewBox.minX} ${dimensions.viewBox.minY} ${dimensions.viewBox.width} ${dimensions.viewBox.height}`
        : '-';
    }
  };

  const showBeforePreview = () => {
    if (!state.loaded || !beforePreview) return;
    beforePreview.src = state.loaded.originalUrl;
    beforePreview.hidden = false;
    if (beforePlaceholder) beforePlaceholder.hidden = true;
  };

  const setAfterPreviewPlaceholder = (message: string) => {
    if (afterPlaceholder) {
      afterPlaceholder.textContent = message;
      afterPlaceholder.hidden = false;
    }
    if (afterPreview) {
      afterPreview.hidden = true;
      afterPreview.removeAttribute('src');
    }
  };

  const getResizedSvgMarkup = async () => {
    if (!state.loaded) throw new Error('Load an SVG first.');
    const logic = await getLogic();
    return logic.serializeSvgWithSize(state.loaded.text, state.outputWidth, state.outputHeight);
  };

  const schedulePreviewRender = () => {
    if (state.previewTimer) window.clearTimeout(state.previewTimer);
    state.previewTimer = window.setTimeout(() => {
      state.previewTimer = null;
      void renderAfterPreview();
    }, 160);
  };

  const renderAfterPreview = async () => {
    if (!state.loaded) {
      revokePreviewUrl();
      setAfterPreviewPlaceholder('Resized preview will update automatically.');
      return;
    }

    const requestId = ++state.previewRequestId;

    try {
      const guardrails = await getOutputGuardrails();
      if (guardrails.blocking.length > 0) {
        revokePreviewUrl();
        setAfterPreviewPlaceholder('Preview disabled: output exceeds current guardrails.');
        return;
      }

      const resizedSvg = await getResizedSvgMarkup();
      if (requestId !== state.previewRequestId) return;

      const blob = new Blob([resizedSvg], { type: 'image/svg+xml;charset=utf-8' });
      const nextUrl = URL.createObjectURL(blob);

      revokePreviewUrl();
      state.previewUrl = nextUrl;
      if (afterPreview) {
        afterPreview.src = nextUrl;
        afterPreview.hidden = false;
      }
      if (afterPlaceholder) afterPlaceholder.hidden = true;
    } catch {
      revokePreviewUrl();
      setAfterPreviewPlaceholder('Could not render preview for this SVG.');
    }
  };

  const refreshUi = async () => {
    await updateControlFields();
    await updateSummary();
    await renderGuardrailMessages();
    toggleFormatPanels();
    await updateInfoPanel();
    schedulePreviewRender();
  };

  const applyDerivedSize = async (next: { width: number; height: number; scale: number }) => {
    if (!state.loaded) return;
    state.outputWidth = next.width;
    state.outputHeight = next.height;
    state.scale = next.scale;
    setExportStatus('');
    await refreshUi();
  };

  const applyScale = async (scaleValue: number) => {
    if (!state.loaded) return;
    const logic = await getLogic();
    const derived = logic.deriveSizeFromScale(state.loaded.dimensions.width, state.loaded.dimensions.height, scaleValue);
    await applyDerivedSize(derived);
  };

  const applyPercent = async (percentValue: number) => {
    await applyScale(percentValue / 100);
  };

  const applyWidth = async (nextWidth: number) => {
    if (!state.loaded) return;
    const logic = await getLogic();
    const derived = logic.deriveSizeFromWidth(state.loaded.dimensions.width, state.loaded.dimensions.height, nextWidth);
    await applyDerivedSize(derived);
  };

  const applyHeight = async (nextHeight: number) => {
    if (!state.loaded) return;
    const logic = await getLogic();
    const derived = logic.deriveSizeFromHeight(state.loaded.dimensions.width, state.loaded.dimensions.height, nextHeight);
    await applyDerivedSize(derived);
  };

  const readFileText = async (file: File) => file.text();

  const loadSvgFile = async (file: File) => {
    setExportStatus('');
    const logic = await getLogic();
    const text = await readFileText(file);
    const dimensions = logic.parseSvgDimensions(text);

    if (state.loaded?.originalUrl) {
      URL.revokeObjectURL(state.loaded.originalUrl);
    }
    revokePreviewUrl();

    state.loaded = {
      text,
      fileName: file.name,
      originalUrl: URL.createObjectURL(file),
      dimensions
    };
    state.outputWidth = logic.roundPixelDimension(dimensions.width);
    state.outputHeight = logic.roundPixelDimension(dimensions.height);
    state.scale = 1;

    showBeforePreview();
    await refreshUi();
  };

  const withCanvasBlob = (canvas: HTMLCanvasElement, type: string, quality?: number): Promise<Blob> =>
    new Promise((resolve, reject) => {
      canvas.toBlob(
        (blob) => {
          if (blob) resolve(blob);
          else reject(new Error('Could not render image blob.'));
        },
        type,
        quality
      );
    });

  const loadImageFromSvgMarkup = async (svgMarkup: string): Promise<{ image: HTMLImageElement; url: string }> => {
    const blob = new Blob([svgMarkup], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);

    const image = new Image();
    image.decoding = 'async';

    await new Promise<void>((resolve, reject) => {
      image.onload = () => resolve();
      image.onerror = () => reject(new Error('Could not load SVG for rasterization.'));
      image.src = url;
    });

    return { image, url };
  };

  const exportSvg = async (asXmlFile = false) => {
    if (!state.loaded) throw new Error('Load an SVG first.');
    const resizedSvg = await getResizedSvgMarkup();
    const blob = new Blob([resizedSvg], { type: 'image/svg+xml;charset=utf-8' });
    const base = slugifyBaseName(state.loaded.fileName);
    downloadBlob(blob, `${base}-${state.outputWidth}x${state.outputHeight}.${asXmlFile ? 'xml' : 'svg'}`);
  };

  const exportRaster = async (format: 'png' | 'jpeg') => {
    if (!state.loaded) throw new Error('Load an SVG first.');
    const resizedSvg = await getResizedSvgMarkup();
    const { image, url } = await loadImageFromSvgMarkup(resizedSvg);

    try {
      const canvas = document.createElement('canvas');
      canvas.width = state.outputWidth;
      canvas.height = state.outputHeight;
      const context = canvas.getContext('2d');
      if (!context) throw new Error('Could not create canvas context.');

      const bgColor = getEffectiveBackgroundColor(format);
      if (bgColor) {
        context.fillStyle = bgColor;
        context.fillRect(0, 0, canvas.width, canvas.height);
      }

      context.drawImage(image, 0, 0, canvas.width, canvas.height);

      const qualityValue = format === 'jpeg' ? Math.max(0.5, Math.min(1, Number(jpegQuality?.value ?? '90') / 100)) : undefined;
      const mimeType = format === 'png' ? 'image/png' : 'image/jpeg';
      const blob = await withCanvasBlob(canvas, mimeType, qualityValue);
      const base = slugifyBaseName(state.loaded.fileName);
      downloadBlob(blob, `${base}-${state.outputWidth}x${state.outputHeight}.${format === 'jpeg' ? 'jpg' : 'png'}`);
    } finally {
      URL.revokeObjectURL(url);
    }
  };

  const runExport = async (mode: 'primary' | 'androidXml') => {
    if (!state.loaded) {
      setExportStatus('Load an SVG before exporting.');
      return;
    }

    const logic = await getLogic();
    const guardrails = logic.evaluateOutputGuardrails(state.outputWidth, state.outputHeight);
    if (guardrails.blocking.length > 0) {
      setExportStatus(`Export blocked: ${guardrails.blocking.join(' ')}`);
      return;
    }

    try {
      setExportStatus('Preparing download...');
      if (mode === 'androidXml') {
        if (!state.androidXmlEnabled) {
          throw new Error('Android XML export is not enabled for this environment.');
        }
        await exportSvg(true);
      } else {
        const format = getCurrentFormat();
        if (format === 'svg') {
          await exportSvg(false);
        } else {
          await exportRaster(format);
        }
      }
      setExportStatus('Download started.');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Export failed.';
      setExportStatus(message);
    }
  };

  svgFileInput?.addEventListener('change', async () => {
    const file = svgFileInput.files?.[0];
    if (!file) return;

    try {
      await loadSvgFile(file);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Could not read SVG.';
      state.loaded = null;
      revokePreviewUrl();
      setAfterPreviewPlaceholder('Resized preview will update automatically.');
      setExportStatus(message);
      if (fileNameEl) fileNameEl.textContent = 'No SVG loaded.';
      if (dimensionSourceEl) dimensionSourceEl.textContent = 'Dimension source: -';
      await updateSummary();
      await updateInfoPanel();
      if (guardrailMessagesEl) guardrailMessagesEl.innerHTML = '';
    }
  });

  document.getElementById('preset-row')?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>('.preset-btn');
    if (!button) return;
    const presetScale = Number(button.dataset.scale);
    if (!Number.isFinite(presetScale)) return;
    await applyScale(presetScale);
  });

  scaleInput?.addEventListener('change', async () => {
    const nextScale = Number(scaleInput.value);
    if (!Number.isFinite(nextScale) || nextScale <= 0) {
      await updateControlFields();
      return;
    }
    await applyScale(nextScale);
  });

  percentInput?.addEventListener('change', async () => {
    const nextPercent = Number(percentInput.value);
    if (!Number.isFinite(nextPercent) || nextPercent <= 0) {
      await updateControlFields();
      return;
    }
    await applyPercent(nextPercent);
  });

  scaleSlider?.addEventListener('input', async () => {
    const nextScale = Number(scaleSlider.value);
    if (!Number.isFinite(nextScale) || nextScale <= 0) return;
    await applyScale(nextScale);
  });

  widthInput?.addEventListener('change', async () => {
    const nextWidth = Number(widthInput.value);
    if (!Number.isFinite(nextWidth) || nextWidth <= 0) {
      await updateControlFields();
      return;
    }
    await applyWidth(nextWidth);
  });

  heightInput?.addEventListener('change', async () => {
    const nextHeight = Number(heightInput.value);
    if (!Number.isFinite(nextHeight) || nextHeight <= 0) {
      await updateControlFields();
      return;
    }
    await applyHeight(nextHeight);
  });

  formatSelect?.addEventListener('change', async () => {
    toggleFormatPanels();
    await updateSummary();
    setExportStatus('');
  });

  pngFlatten?.addEventListener('change', () => {
    toggleFormatPanels();
    setExportStatus('');
  });

  checkerboardToggle?.addEventListener('change', () => setCheckerboard(!!checkerboardToggle.checked));

  jpegQuality?.addEventListener('input', () => {
    if (jpegQualityLabel) jpegQualityLabel.textContent = String(jpegQuality.value);
  });

  downloadPrimaryBtn?.addEventListener('click', () => void runExport('primary'));
  downloadSvgXmlBtn?.addEventListener('click', () => void runExport('androidXml'));

  syncColorInputs(jpegBg, jpegBgText);
  syncColorInputs(pngBg, pngBgText);
  setCheckerboard(true);
  toggleFormatPanels();
  void updateSummary();
  void initAndroidXmlFlagGate();
</script>
