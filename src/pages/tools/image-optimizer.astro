---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Field from '../../components/ui/Field.astro';
import Input from '../../components/ui/Input.astro';
---

<ToolLayout title="Image Optimization + EXIF Tools">
  <section class="tool-grid">
    <Card interactive={false}>
      <div class="ui-card__header">
        <div>
          <h2 class="ui-card__title">Compress & Optimize</h2>
          <p class="ui-card__description">Adjust JPEG/WebP quality or target a final file size with best-effort iteration.</p>
        </div>
      </div>

      <Field label="Image file" htmlFor="image-input">
        <Input id="image-input" type="file" accept="image/jpeg,image/png,image/webp" />
      </Field>

      <div class="grid">
        <Field label="Output format" htmlFor="format-select">
          <select id="format-select" class="ui-input">
            <option value="image/jpeg">JPEG</option>
            <option value="image/webp">WebP</option>
          </select>
        </Field>

        <Field label="Quality (1-100)" htmlFor="quality-input">
          <Input id="quality-input" type="range" min="1" max="100" value="80" />
        </Field>
      </div>

      <div class="grid">
        <Field label="Target size in KB (optional)" htmlFor="target-size">
          <Input id="target-size" type="number" min="1" placeholder="e.g. 200" />
        </Field>
      </div>

      <div class="actions">
        <Button id="compress-button" variant="primary">Compress image</Button>
        <Button id="strip-button" variant="secondary">Strip metadata only</Button>
      </div>

      <div id="size-summary" class="output">Upload an image to begin.</div>
      <a id="download-link" class="download-link" hidden download>Download output</a>
    </Card>

    <Card interactive={false}>
      <div class="ui-card__header">
        <div>
          <h2 class="ui-card__title">EXIF Reader</h2>
          <p class="ui-card__description">Read camera and GPS metadata from JPEG files locally in your browser.</p>
        </div>
      </div>

      <dl id="exif-panel" class="exif-panel" aria-live="polite">
        <div><dt>Status</dt><dd>Choose a JPEG image to automatically read EXIF.</dd></div>
      </dl>

      <div class="actions">
        <Button id="read-exif-button" variant="secondary">Refresh EXIF</Button>
      </div>
    </Card>
  </section>
</ToolLayout>

<style>
  :global(main.tool-content) {
    width: min(100%, 92rem) !important;
    max-width: min(100%, 92rem) !important;
  }

  .tool-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: start;
  }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md); }
  .actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-md); }
  .output { margin-top: var(--space-md); padding: var(--space-md); border: 1px solid var(--border-default); border-radius: var(--radius-md); }
  .download-link { display: inline-block; margin-top: var(--space-sm); }
  .exif-panel { margin-top: var(--space-md); display: grid; gap: var(--space-sm); }
  .exif-panel div { display: grid; grid-template-columns: minmax(140px, 180px) 1fr; gap: var(--space-sm); border: 1px solid var(--border-default); border-radius: var(--radius-sm); padding: var(--space-sm) var(--space-md); }
  .exif-panel dt { color: var(--text-secondary); }

  @media (max-width: 1080px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type Logic = typeof import('../../tools/image-optimizer/logic');
  let logic: Logic | null = null;

  const getLogic = async (): Promise<Logic> => {
    if (!logic) logic = await import('../../tools/image-optimizer/logic');
    return logic;
  };

  const fileInput = document.getElementById('image-input') as HTMLInputElement | null;
  const formatSelect = document.getElementById('format-select') as HTMLSelectElement | null;
  const qualityInput = document.getElementById('quality-input') as HTMLInputElement | null;
  const targetInput = document.getElementById('target-size') as HTMLInputElement | null;
  const summaryNode = document.getElementById('size-summary');
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement | null;
  const exifPanel = document.getElementById('exif-panel');

  let activeUrl: string | null = null;

  const getSelectedFile = (): File | null => fileInput?.files?.item(0) ?? null;

  const readBuffer = async (file: File): Promise<ArrayBuffer> => await file.arrayBuffer();

  const toImageBitmap = async (file: File): Promise<ImageBitmap> => await createImageBitmap(file);

  const canvasToBlob = async (canvas: HTMLCanvasElement, type: string, quality?: number): Promise<Blob> =>
    new Promise((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (!blob) {
          reject(new Error('Unable to encode image.'));
          return;
        }
        resolve(blob);
      }, type, quality);
    });

  const encodeFromCanvas = async (file: File, mimeType: string, quality: number): Promise<Blob> => {
    const image = await toImageBitmap(file);
    const canvas = document.createElement('canvas');
    canvas.width = image.width;
    canvas.height = image.height;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas context unavailable.');
    ctx.drawImage(image, 0, 0);
    return await canvasToBlob(canvas, mimeType, quality);
  };

  const setDownload = (blob: Blob, originalName: string): void => {
    if (!downloadLink) return;
    if (activeUrl) URL.revokeObjectURL(activeUrl);

    activeUrl = URL.createObjectURL(blob);
    downloadLink.href = activeUrl;
    downloadLink.hidden = false;

    const extension = blob.type === 'image/webp' ? 'webp' : 'jpg';
    downloadLink.download = `${originalName.replace(/\.[^.]+$/, '')}-optimized.${extension}`;
    downloadLink.textContent = `Download (${extension.toUpperCase()})`;
  };

  const renderSavings = async (originalBytes: number, outputBytes: number): Promise<void> => {
    if (!summaryNode) return;
    const { createSavingsSummary, formatBytes } = await getLogic();
    const summary = createSavingsSummary(originalBytes, outputBytes);

    summaryNode.textContent = `Original: ${formatBytes(summary.originalBytes)} | Output: ${formatBytes(summary.outputBytes)} | Savings: ${formatBytes(summary.savedBytes)} (${summary.savedPercent.toFixed(1)}%)`;
  };

  const compressImage = async (): Promise<void> => {
    const file = getSelectedFile();
    if (!file || !summaryNode || !qualityInput || !formatSelect) return;

    const mimeType = formatSelect.value;
    const baseQuality = Math.min(1, Math.max(0.01, Number(qualityInput.value) / 100));

    try {
      let outputBlob: Blob;
      const targetKb = Number(targetInput?.value ?? '0');

      if (Number.isFinite(targetKb) && targetKb > 0) {
        const { estimateTargetQuality } = await getLogic();
        const targetBytes = targetKb * 1024;

        const estimated = await estimateTargetQuality(targetBytes, async (quality) => {
          const encoded = await encodeFromCanvas(file, mimeType, quality);
          return encoded.size;
        });

        outputBlob = await encodeFromCanvas(file, mimeType, estimated.quality);
      } else {
        outputBlob = await encodeFromCanvas(file, mimeType, baseQuality);
      }

      setDownload(outputBlob, file.name);
      await renderSavings(file.size, outputBlob.size);
    } catch (error) {
      summaryNode.textContent = error instanceof Error ? error.message : 'Compression failed.';
    }
  };

  const stripMetadata = async (): Promise<void> => {
    const file = getSelectedFile();
    if (!file || !summaryNode) return;

    try {
      const mimeType = file.type === 'image/webp' ? 'image/webp' : 'image/jpeg';
      const stripped = await encodeFromCanvas(file, mimeType, 0.92);
      setDownload(stripped, file.name);
      await renderSavings(file.size, stripped.size);
      summaryNode.textContent = `${summaryNode.textContent} | Metadata stripped by re-encoding.`;
    } catch (error) {
      summaryNode.textContent = error instanceof Error ? error.message : 'Metadata stripping failed.';
    }
  };

  const renderExif = (entries: Array<{ label: string; value: string }>): void => {
    if (!exifPanel) return;
    if (entries.length === 0) {
      exifPanel.innerHTML = '<div><dt>Status</dt><dd>No EXIF metadata found.</dd></div>';
      return;
    }

    exifPanel.innerHTML = entries
      .map(({ label, value }) => `<div><dt>${label}</dt><dd>${value}</dd></div>`)
      .join('');
  };

  const readExif = async (): Promise<void> => {
    const file = getSelectedFile();
    if (!file || !exifPanel) return;
    if (!file.type.includes('jpeg')) {
      exifPanel.innerHTML = '<div><dt>Status</dt><dd>EXIF reader currently supports JPEG input.</dd></div>';
      return;
    }

    try {
      const { parseExifFromJpeg } = await getLogic();
      const parsed = parseExifFromJpeg(await readBuffer(file));
      if (!parsed) {
        renderExif([]);
        return;
      }

      const entries: Array<{ label: string; value: string }> = [];
      const pushIf = (label: string, value: unknown): void => {
        if (value === undefined || value === null || value === '') return;
        entries.push({ label, value: String(value) });
      };

      pushIf('Make', parsed.make);
      pushIf('Model', parsed.model);
      pushIf('Software', parsed.software);
      pushIf('Date/Time', parsed.dateTime);
      pushIf('Date/Time Original', parsed.dateTimeOriginal);
      pushIf('ISO', parsed.iso);
      pushIf('Exposure', parsed.exposureTime);
      pushIf('F Number', parsed.fNumber);
      pushIf('Focal Length', parsed.focalLength);
      pushIf('Width', parsed.pixelWidth);
      pushIf('Height', parsed.pixelHeight);
      pushIf('GPS Latitude', parsed.gpsLatitude?.toFixed(6));
      pushIf('GPS Longitude', parsed.gpsLongitude?.toFixed(6));
      renderExif(entries);
    } catch (error) {
      exifPanel.innerHTML = `<div><dt>Error</dt><dd>${error instanceof Error ? error.message : 'EXIF parsing failed.'}</dd></div>`;
    }
  };

  fileInput?.addEventListener('change', () => {
    void readExif();
  });

  document.getElementById('compress-button')?.addEventListener('click', () => {
    void compressImage();
  });

  document.getElementById('strip-button')?.addEventListener('click', () => {
    void stripMetadata();
  });

  document.getElementById('read-exif-button')?.addEventListener('click', () => {
    void readExif();
  });
</script>
