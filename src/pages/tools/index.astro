---
import AppShell from '../../layouts/AppShell.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { createTranslator, resolveLocaleFromPathname } from '../../i18n';
const t = createTranslator(resolveLocaleFromPathname(Astro.url.pathname));
---
<AppShell title={t('pages.toolsIndex.title')}>
  <main id="main-content" class="ui-page directory-page" tabindex="-1">
    <div class="directory-intro"><p class="eyebrow">{t('workbench.collection')}</p><h1>{t('shell.nav.allTools')}</h1><p>{t('workbench.toolsIntro')}</p></div>
    <ToolDirectory sectionId="tools" />
  </main>
</AppShell>
