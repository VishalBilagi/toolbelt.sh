---
import AppShell from '../../layouts/AppShell.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { createTranslator, resolveLocaleFromPathname } from '../../i18n';

const locale = resolveLocaleFromPathname(Astro.url.pathname);
const translate = createTranslator(locale);
---

<AppShell title={translate('pages.toolsIndex.title')}>
  <main class="ui-page tools-page">
    <div class="tools-actions ui-cluster">
    </div>

    <ToolDirectory />
  </main>
</AppShell>

<style>
  .tools-page {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-4xl);
    display: grid;
    gap: var(--space-xl);
  }

  .tools-actions {
    justify-content: flex-start;
  }
</style>
