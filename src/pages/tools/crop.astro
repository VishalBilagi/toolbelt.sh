---
import Analytics from '@vercel/analytics/astro';
import {
  createTranslator,
  localizeAppLink,
  resolveLocaleFromPathname,
} from '../../i18n';

const locale = resolveLocaleFromPathname(Astro.url.pathname);
const translate = createTranslator(locale);
const target = localizeAppLink('/tools/image-editor', locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{translate('pages.crop.redirectTitle')}</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      {translate('pages.crop.redirectMessage')} <a href={target}>{target}</a>...
    </p>
    <Analytics />
  </body>
  </html>
