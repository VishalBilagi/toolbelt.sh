---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Field from '../../components/ui/Field.astro';
import Input from '../../components/ui/Input.astro';
---

<ToolLayout title="PDF Toolkit">
  <section class="pdf-shell">
    <nav class="pdf-tabs" aria-label="PDF toolkit modes">
      <button type="button" class="pdf-tab is-active" data-pdf-tab="merge" aria-controls="pdf-panel-merge" aria-selected="true">
        Merge
      </button>
      <button type="button" class="pdf-tab" data-pdf-tab="split" aria-controls="pdf-panel-split" aria-selected="false">
        Split
      </button>
      <button type="button" class="pdf-tab" data-pdf-tab="extract" aria-controls="pdf-panel-extract" aria-selected="false">
        Extract Pages
      </button>
    </nav>

    <section id="pdf-panel-merge" class="pdf-panel" data-pdf-panel="merge">
      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">Merge PDFs</h2>
            <p class="ui-card__description">Combine multiple PDF files in order and export one merged document.</p>
          </div>
        </div>

        <div class="panel-grid">
          <section class="panel-box">
            <Field label="PDF files" htmlFor="merge-files-input">
              <Input id="merge-files-input" type="file" accept="application/pdf" multiple />
            </Field>

            <p id="merge-files-list" class="hint">No files selected.</p>

            <div class="actions">
              <Button id="merge-run" variant="primary">Merge PDFs</Button>
            </div>

            <p id="merge-status" class="status" aria-live="polite">Ready.</p>
          </section>

          <section class="panel-box preview-box">
            <div class="preview-head">
              <h3>Preview</h3>
              <span id="merge-preview-label" class="preview-label">No PDF selected</span>
            </div>
            <iframe id="merge-preview-frame" class="pdf-preview" title="Merge PDF preview" hidden></iframe>
            <p id="merge-preview-empty" class="hint">Select one or more PDFs to preview and merge.</p>
          </section>
        </div>
      </Card>
    </section>

    <section id="pdf-panel-split" class="pdf-panel" data-pdf-panel="split" hidden>
      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">Split PDF</h2>
            <p class="ui-card__description">Split one PDF into one-file-per-page exports.</p>
          </div>
        </div>

        <div class="panel-grid">
          <section class="panel-box">
            <Field label="PDF file" htmlFor="split-file-input">
              <Input id="split-file-input" type="file" accept="application/pdf" />
            </Field>

            <div class="actions">
              <Button id="split-run" variant="primary">Split PDF</Button>
            </div>

            <p id="split-status" class="status" aria-live="polite">Ready.</p>
          </section>

          <section class="panel-box preview-box">
            <div class="preview-head">
              <h3>Preview</h3>
              <span id="split-preview-label" class="preview-label">No PDF selected</span>
            </div>
            <iframe id="split-preview-frame" class="pdf-preview" title="Split PDF preview" hidden></iframe>
            <p id="split-preview-empty" class="hint">Choose a PDF to inspect before splitting.</p>
          </section>
        </div>
      </Card>
    </section>

    <section id="pdf-panel-extract" class="pdf-panel" data-pdf-panel="extract" hidden>
      <Card interactive={false}>
        <div class="ui-card__header">
          <div>
            <h2 class="ui-card__title">Extract Pages</h2>
            <p class="ui-card__description">Pick a page list like <code>1,3-5</code> and export only those pages.</p>
          </div>
        </div>

        <div class="panel-grid">
          <section class="panel-box">
            <Field label="PDF file" htmlFor="extract-file-input">
              <Input id="extract-file-input" type="file" accept="application/pdf" />
            </Field>

            <Field label="Pages to extract" htmlFor="extract-pages-input">
              <Input id="extract-pages-input" type="text" placeholder="1,3-5" />
            </Field>

            <div class="actions">
              <Button id="extract-run" variant="primary">Extract pages</Button>
            </div>

            <p id="extract-status" class="status" aria-live="polite">Ready.</p>
          </section>

          <section class="panel-box preview-box">
            <div class="preview-head">
              <h3>Preview</h3>
              <span id="extract-preview-label" class="preview-label">No PDF selected</span>
            </div>
            <iframe id="extract-preview-frame" class="pdf-preview" title="Extract PDF preview" hidden></iframe>
            <p id="extract-preview-empty" class="hint">Choose a PDF and page range, then export a new file.</p>
          </section>
        </div>
      </Card>
    </section>
  </section>
</ToolLayout>

<style>
  .pdf-shell {
    display: grid;
    gap: var(--space-lg);
  }

  .pdf-tabs {
    display: flex;
    gap: 0.55rem;
    overflow-x: auto;
    padding: 0.45rem;
    border-radius: calc(var(--radius-lg) + 0.2rem);
    border: 1px solid var(--border-default);
    background: color-mix(in srgb, var(--bg-surface) 92%, transparent);
    position: sticky;
    top: 5.2rem;
    z-index: 4;
    backdrop-filter: blur(8px);
  }

  .pdf-tab {
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    min-height: 2.55rem;
    padding: 0.55rem 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .pdf-tab:hover,
  .pdf-tab:focus-visible {
    color: var(--text-primary);
    border-color: color-mix(in srgb, var(--accent) 24%, var(--border-default));
    background: color-mix(in srgb, var(--bg-inset) 74%, transparent);
  }

  .pdf-tab.is-active {
    color: var(--text-primary);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border-default));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 18%, transparent),
      color-mix(in srgb, var(--bg-inset) 82%, transparent)
    );
  }

  .pdf-panel[hidden] {
    display: none;
  }

  .panel-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .panel-box {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-surface) 94%, transparent), color-mix(in srgb, var(--bg-surface) 86%, transparent));
    padding: var(--space-md);
    min-width: 0;
  }

  .actions {
    margin-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .status {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
  }

  .hint {
    margin-top: var(--space-sm);
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .preview-box {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .preview-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .preview-head h3 {
    margin: 0;
    font-size: 1rem;
  }

  .preview-label {
    color: var(--text-tertiary);
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }

  .pdf-preview {
    width: 100%;
    min-height: 28rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-inset) 90%, transparent);
  }

  @media (max-width: 1100px) {
    .panel-grid {
      grid-template-columns: 1fr;
    }

    .pdf-preview {
      min-height: 22rem;
    }
  }
</style>

<script>
  let logic: typeof import('../../tools/pdf-toolkit/logic') | null = null;

  const getLogic = async () => {
    if (!logic) {
      logic = await import('../../tools/pdf-toolkit/logic');
    }

    return logic;
  };

  const byId = <T extends HTMLElement>(id: string): T | null => document.getElementById(id) as T | null;

  const readFileBytes = async (file: File): Promise<Uint8Array> => {
    const buffer = await file.arrayBuffer();
    return new Uint8Array(buffer);
  };

  const downloadBytes = (filename: string, bytes: Uint8Array) => {
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const href = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = href;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(href);
  };

  const previewUrlByMode: Record<string, string | null> = {
    merge: null,
    split: null,
    extract: null,
  };

  const setTab = (mode: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-pdf-tab]').forEach((button) => {
      const active = button.dataset.pdfTab === mode;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    document.querySelectorAll<HTMLElement>('[data-pdf-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.pdfPanel !== mode;
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-pdf-tab]').forEach((button) => {
    button.addEventListener('click', () => setTab(button.dataset.pdfTab ?? 'merge'));
  });

  const setPreview = (mode: 'merge' | 'split' | 'extract', file: File | null) => {
    const frame = byId<HTMLIFrameElement>(`${mode}-preview-frame`);
    const empty = byId<HTMLElement>(`${mode}-preview-empty`);
    const label = byId<HTMLElement>(`${mode}-preview-label`);

    if (!frame || !empty || !label) return;

    if (previewUrlByMode[mode]) {
      URL.revokeObjectURL(previewUrlByMode[mode] ?? '');
      previewUrlByMode[mode] = null;
    }

    if (!file) {
      frame.hidden = true;
      frame.removeAttribute('src');
      empty.hidden = false;
      label.textContent = 'No PDF selected';
      return;
    }

    const href = URL.createObjectURL(file);
    previewUrlByMode[mode] = href;
    frame.src = href;
    frame.hidden = false;
    empty.hidden = true;
    label.textContent = file.name;
  };

  const mergeFilesInput = byId<HTMLInputElement>('merge-files-input');
  const mergeFilesList = byId<HTMLElement>('merge-files-list');
  const mergeStatus = byId<HTMLElement>('merge-status');

  mergeFilesInput?.addEventListener('change', () => {
    const files = [...(mergeFilesInput.files ?? [])];
    if (!mergeFilesList) return;

    mergeFilesList.textContent = files.length > 0 ? files.map((file) => file.name).join(' • ') : 'No files selected.';
    setPreview('merge', files[0] ?? null);
  });

  document.getElementById('merge-run')?.addEventListener('click', async () => {
    try {
      const files = [...(mergeFilesInput?.files ?? [])];
      const bytes = await Promise.all(files.map((file) => readFileBytes(file)));
      const { mergePdfFiles } = await getLogic();
      const result = await mergePdfFiles(bytes);
      downloadBytes('merged.pdf', result.bytes);

      if (mergeStatus) {
        mergeStatus.textContent = `Merged ${files.length} files (${result.pageCount} total pages).`;
      }
    } catch (error) {
      if (mergeStatus) {
        mergeStatus.textContent = error instanceof Error ? error.message : 'Unable to merge PDFs.';
      }
    }
  });

  const splitFileInput = byId<HTMLInputElement>('split-file-input');
  const splitStatus = byId<HTMLElement>('split-status');

  splitFileInput?.addEventListener('change', () => {
    setPreview('split', splitFileInput.files?.[0] ?? null);
  });

  document.getElementById('split-run')?.addEventListener('click', async () => {
    try {
      const file = splitFileInput?.files?.[0];
      if (!file) {
        throw new Error('Choose a PDF file to split.');
      }

      const { splitPdfIntoSinglePages } = await getLogic();
      const pages = await splitPdfIntoSinglePages(await readFileBytes(file));
      const baseName = file.name.replace(/\.pdf$/i, '') || 'split';

      pages.forEach((pageBytes, index) => {
        downloadBytes(`${baseName}-page-${index + 1}.pdf`, pageBytes);
      });

      if (splitStatus) {
        splitStatus.textContent = `Created ${pages.length} single-page PDFs.`;
      }
    } catch (error) {
      if (splitStatus) {
        splitStatus.textContent = error instanceof Error ? error.message : 'Unable to split PDF.';
      }
    }
  });

  const extractFileInput = byId<HTMLInputElement>('extract-file-input');
  const extractPagesInput = byId<HTMLInputElement>('extract-pages-input');
  const extractStatus = byId<HTMLElement>('extract-status');

  extractFileInput?.addEventListener('change', () => {
    setPreview('extract', extractFileInput.files?.[0] ?? null);
  });

  document.getElementById('extract-run')?.addEventListener('click', async () => {
    try {
      const file = extractFileInput?.files?.[0];
      if (!file) {
        throw new Error('Choose a PDF file to extract pages from.');
      }

      const { extractPdfPages, parsePageSelection } = await getLogic();
      const parsedPages = parsePageSelection(extractPagesInput?.value ?? '');
      const result = await extractPdfPages(await readFileBytes(file), parsedPages);

      const baseName = file.name.replace(/\.pdf$/i, '') || 'extracted';
      downloadBytes(`${baseName}-extracted.pdf`, result.bytes);

      if (extractStatus) {
        extractStatus.textContent = `Extracted ${result.pageCount} page(s).`;
      }
    } catch (error) {
      if (extractStatus) {
        extractStatus.textContent = error instanceof Error ? error.message : 'Unable to extract pages.';
      }
    }
  });
</script>
