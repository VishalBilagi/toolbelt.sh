---
import AppShell from '../layouts/AppShell.astro';
import ToolDirectory from '../components/ToolDirectory.astro';
import Icon from '../components/ui/Icon.astro';
import { toolSections } from '../data/tool-directory';
import { createTranslator, getLocalizedToolText, localizeAppLink, resolveLocaleFromPathname } from '../i18n';
const locale = resolveLocaleFromPathname(Astro.url.pathname);
const t = createTranslator(locale);
const tools = toolSections.flatMap(section => section.tools);
---
<AppShell title="toolbelt.sh — Your everyday toolkit">
  <main id="main-content" class="ui-page landing" tabindex="-1">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span>{t('workbench.eyebrow')}</p>
        <h1>{t('workbench.headline')}<br /><span>{t('workbench.headlineAccent')}</span></h1>
        <p class="hero-description">{t('workbench.intro')}</p>
        <div class="hero-benefits"><span><Icon name="lock" />{t('workbench.private')}</span><span><Icon name="bolt" />{t('workbench.free')}</span></div>
      </div>
      <div class="hero-note" aria-hidden="true"><span class="hero-note-icon"><Icon name="terminal" /></span><span class="hero-note-number">{String(tools.length).padStart(2, '0')}<span> / tools</span></span><span class="hero-note-caption">{t('workbench.ready')}</span><div class="hero-note-icons"><Icon name="crop" /><Icon name="data" /><Icon name="qr" /><Icon name="clock" /></div></div>
    </section>
    <section class="recent-section" data-recent-section hidden aria-label={t('workbench.recent')}>
      <p class="eyebrow">{t('workbench.recentLabel')}</p>
      <div class="recent-tools">{tools.map(tool => <a href={localizeAppLink(tool.href, locale)} data-recent-tool={tool.href} hidden><Icon name={tool.icon} /><span>{getLocalizedToolText(locale, tool.href, tool.name, tool.description).name}</span><Icon name="arrow-up-right" /></a>)}</div>
    </section>
    <ToolDirectory sectionId="tools" />
    <footer class="directory-footer"><nav aria-label={t('home.footer.toolLinksAria')}>{tools.map(tool => <a href={localizeAppLink(tool.href, locale)}>{getLocalizedToolText(locale, tool.href, tool.name, tool.description).name}</a>)}</nav><p>{t('home.footer.copy')}</p></footer>
  </main>
</AppShell>
